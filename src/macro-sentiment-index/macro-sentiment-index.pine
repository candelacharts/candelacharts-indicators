msi_hyg_lqd_ratio_weight                = input.float(1.3, title="", minval=0.1, maxval=3.0, step=0.1, inline="2.0", group = "Sentiment Ratios", tooltip = "Junk vs IG credit risk appetite")
msi_use_copper_gold_ratio               = input.bool(true, title="HG/GC Weight    ", inline="3.0", group = "Sentiment Ratios")
msi_copper_gold_ratio_weight            = input.float(1.2, title="", minval=0.1, maxval=3.0, step=0.1, inline="3.0", group = "Sentiment Ratios", tooltip = "Growth vs Safe Haven")
