// msi_ted_weight                          = input.float(1.4, title="", minval=0.1, maxval=3.0, step=0.1, inline="6.0", group = "Macro & Interest Rate", tooltip = "Include TED Spread (banking stress)")
msi_use_move                            = input.bool(true, title="MOVE Weight     ", inline="7.0", group = "Macro & Interest Rate")
msi_move_value                          = input.string("MOVE", "", inline = "7.0", group = "Macro & Interest Rate")
msi_move_weight                         = input.float(1.3, title="", minval=0.1, maxval=3.0, step=0.1, inline="7.0", group = "Macro & Interest Rate", tooltip = "Include MOVE Index (bond volatility)")
msi_use_breakeven                       = input.bool(true, title="TIP/TLT Weight   ", inline="9.0", group = "Macro & Interest Rate")
msi_tip_value                           = input.string("TIP", "", inline = "9.0", group = "Macro & Interest Rate")
msi_breakeven_weight                    = input.float(0.9, title="", minval=0.1, maxval=3.0, step=0.1, inline="9.0", group = "Macro & Interest Rate", tooltip = "Use TIP/TLT as breakeven inflation proxy")
msi_use_oil                             = input.bool(false, title="CL Weight          ", inline="10.0", group = "Macro & Interest Rate")
msi_oil_value                           = input.string("CL1!", "", inline = "10.0", group = "Macro & Interest Rate")
msi_oil_weight                          = input.float(1.0, title="", minval=0.1, maxval=3.0, step=0.1, inline="10.0", group = "Macro & Interest Rate", tooltip = "Include Crude Oil (CL1!)")
msi_use_bdiy                            = input.bool(true, title="BDI Weight         ", inline="11.0", group = "Macro & Interest Rate")
msi_bdiy_value                          = input.string("BDI", "", inline = "11.0", group = "Macro & Interest Rate")
msi_bdiy_weight                         = input.float(1.1, title="", minval=0.1, maxval=3.0, step=0.1, inline="11.0", group = "Macro & Interest Rate", tooltip = "Include Baltic Dry Index (BDIY)")

// // Central Bank & Policy
msi_use_effr_futures                    = input.bool(true, title="FF1! Weight         ", inline="1.0", group = "Central Bank & Policy")
msi_effr_value                          = input.string("FF1!", "", inline = "1.0", group = "Central Bank & Policy")
msi_effr_weight                         = input.float(1.1, title="", minval=0.1, maxval=3.0, step=0.1, inline="1.0", group = "Central Bank & Policy", tooltip = "Effective Fed Funds futures – rate expectations")
msi_use_ed_futures                      = input.bool(true, title="ED1! Weight        ", inline="2.0", group = "Central Bank & Policy")
msi_ed_value                            = input.string("ED1!", "", inline = "2.0", group = "Central Bank & Policy")
msi_ed_weight                           = input.float(1.0, title="", minval=0.1, maxval=3.0, step=0.1, inline="2.0", group = "Central Bank & Policy", tooltip = "Eurodollar futures – liquidity & rate expectations")
msi_use_sofr_futures                    = input.bool(true, title="SR3 Weight         ", inline="3.0", group = "Central Bank & Policy")
msi_sofr_value                          = input.string("SR3", "", inline = "3.0", group = "Central Bank & Policy")
msi_sofr_weight                         = input.float(1.1, title="", minval=0.1, maxval=3.0, step=0.1, inline="3.0", group = "Central Bank & Policy", tooltip = "SOFR futures – new benchmark for rates")

// // Cross-Asset Global Risk
msi_use_emfx                            = input.bool(false, title="CEW Weight       ", inline="1.0", group = "Cross-Asset Global Risk")
msi_emfx_value                          = input.string("CEW", "", inline = "1.0", group = "Cross-Asset Global Risk")
msi_emfx_weight                         = input.float(1.1, title="", minval=0.1, maxval=3.0, step=0.1, inline="1.0", group = "Cross-Asset Global Risk", tooltip = "Emerging Markets FX ETF – sensitive to global risk")
msi_use_china_a50                       = input.bool(false, title="CN50 Weight     ", inline="2.0", group = "Cross-Asset Global Risk")
msi_china_a50_value                     = input.string("CN50", "", inline = "2.0", group = "Cross-Asset Global Risk")
msi_china_a50_weight                    = input.float(1.2, title="", minval=0.1, maxval=3.0, step=0.1, inline="2.0", group = "Cross-Asset Global Risk", tooltip = "China A50 – key proxy for global growth sentiment")
msi_use_bund_yield                      = input.bool(false, title="DE10Y Weight    ", inline="3.0", group = "Cross-Asset Global Risk")
msi_bund_yield_value                    = input.string("DE10Y", "", inline = "3.0", group = "Cross-Asset Global Risk")
msi_bund_yield_weight                   = input.float(1.0, title="", minval=0.1, maxval=3.0, step=0.1, inline="3.0", group = "Cross-Asset Global Risk", tooltip = "German 10Y yield – Eurozone risk & global rate anchor")
msi_use_btp_bund_spread                 = input.bool(false, title="BTP/Bund Weight", inline="4.0", group = "Cross-Asset Global Risk")
msi_btp_bund_spread_value               = input.string("BTPBUND", "", inline = "4.0", group = "Cross-Asset Global Risk")
msi_btp_bund_spread_weight              = input.float(1.4, title="", minval=0.1, maxval=3.0, step=0.1, inline="4.0", group = "Cross-Asset Global Risk", tooltip = "Italian vs German yield spread – Eurozone stress gauge")

// // Volatility Indices (beyond VIX)
msi_use_vvix                            = input.bool(true, title="VVIX Weight       ", inline="1.0", group = "Volatility Indices")
msi_vvix_value                          = input.string("VVIX", "", inline = "1.0", group = "Volatility Indices")
msi_vvix_weight                         = input.float(1.3, title="", minval=0.1, maxval=3.0, step=0.1, inline="1.0", group = "Volatility Indices", tooltip = "Volatility of VIX – 'fear of fear'")
msi_use_vix_vvix_ratio                  = input.bool(true, title="VIX/VVIX Weight  ", inline="2.0", group = "Volatility Indices")
msi_vix_vvix_ratio_weight               = input.float(1.2, title="", minval=0.1, maxval=3.0, step=0.1, inline="2.0", group = "Volatility Indices", tooltip = "Complacency signal – low ratio = extreme fear")

