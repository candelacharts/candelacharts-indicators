// Ratios
msi_use_spy_tlt_ratio                   = input.bool(true, title="SPY/TLT Weight   ", inline="1.0", group = "Sentiment Ratios")
msi_spy_tlt_ratio_weight                = input.float(1.5, title="", minval=0.1, maxval=3.0, step=0.1, inline="1.0", group = "Sentiment Ratios", tooltip = "Equities vs Bonds (classic risk-on/off)")
