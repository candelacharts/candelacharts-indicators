//@version=6
indicator("CandelaCharts - Macro Sentiment Index", "CandelaCharts - Macro Sentiment Index", overlay=false, max_lines_count=500)











// # ========================================================================= #
// # |   Colors   |
// # ========================================================================= #

//#region

// # Core -------------------------------------------------------------------- #

colors_white                        = color.white
colors_black                        = color.black
colors_purple                       = color.purple
colors_red                          = color.red
colors_gray                         = color.gray
colors_blue                         = color.blue
colors_orange                       = color.orange
colors_green                        = color.green
color_transparent                   = #ffffff00

// # Custom ------------------------------------------------------------------ #

colors_cyan_dark                    = #089981
colors_red_bright                   = #f23645
colors_purple_dark                  = #7E57C2

//#endregion

// # ========================================================================= #
// # |   End   |
// # ========================================================================= #












// # ========================================================================= #
// # |   Inputs   |
// # ========================================================================= #

//#region

// # General ----------------------------------------------------------------- #

general_font                            = input.string("Monospace", "Text                       ", options = ["Default", "Monospace"], inline = "1.0", group = "General")
general_text                            = input.string("Tiny", "", options = ["Tiny", "Small", "Normal", "Large", "Huge", "Auto"], inline = "1.0", group = "General", tooltip = "Customize global text size and style")
general_brand_show                      = input.bool(false, "Hide Brand", group = "General")

// # MSI --------------------------------------------------------------------- #

msi_lookback                            = input.int(60, title="Lookback                ", minval=10, maxval=200, inline = "1.0", group = "Settings", tooltip = "Lookback Period")
msi_sentiment_bull_color                = input.color(colors_blue, "", inline = "1.0", group = "Settings")
msi_sentiment_bear_color                = input.color(colors_orange, "", inline = "1.0", group = "Settings")
msi_ma_show                             = input.bool(false, title="MA                  ", inline = "2.0", group = "Settings")
msi_ma_type                             = input.string("SMA", title="", options = ["SMA", "EMA", "RMA", "VWMA"], inline = "2.0", group = "Settings")
msi_ma_line_color                       = input.color(colors_black, "", inline = "2.0", group = "Settings")
msi_ma_length                           = input.int(50, title="MA Smoothing         ", minval=1, maxval=200, inline = "3.0", group = "Settings", tooltip = "Moving Average Smoothing")
msi_ma_line_width                       = input.int(2, "", minval = 1, maxval = 4, inline = "3.0", group = "Settings", tooltip = "Width of the Moving Average line")
msi_correlation_length                  = input.int(20, title="Correlation              ", minval=5, maxval=200, inline = "4.0", group = "Settings", tooltip = "Correlation Length")
msi_mode                                = input.string("Columns", title="Mode                       ", options = ["Columns", "Histogram", "Area", "Line"], inline = "5.0", group = "Settings")
msi_table_show                          = input.bool(false, title="Show Table", inline = "5.0", group = "Settings")

// Risk-On Assets
msi_use_spy                             = input.bool(true, title="SPY Weight       ", inline="1.0", group = "Risk-On Assets & Weights")
msi_spy_value                           = input.string("SPY", "", inline = "1.0", group = "Risk-On Assets & Weights")
msi_spy_weight                          = input.float(1.2, title="", minval=0.1, maxval=3.0, step=0.1, inline="1.0", group = "Risk-On Assets & Weights", tooltip = "Include S&P 500 (SPY)")
msi_use_em                              = input.bool(true, title="EEM Weight      ", inline="2.0", group = "Risk-On Assets & Weights")
msi_em_value                            = input.string("EEM", "", inline = "2.0", group = "Risk-On Assets & Weights")
msi_em_weight                           = input.float(0.9, title="", minval=0.1, maxval=3.0, step=0.1, inline="2.0", group = "Risk-On Assets & Weights", tooltip = "Include Emerging Markets (EEM)")
msi_use_hyg                             = input.bool(true, title="HYG Weight      ", inline="3.0", group = "Risk-On Assets & Weights")
msi_hyg_value                           = input.string("HYG", "", inline = "3.0", group = "Risk-On Assets & Weights")
msi_hyg_weight                          = input.float(1.3, title="", minval=0.1, maxval=3.0, step=0.1, inline="3.0", group = "Risk-On Assets & Weights", tooltip = "Include High Yield Bonds (HYG)")
msi_use_qqq                             = input.bool(true, title="NDX Weight       ", inline="4.0", group = "Risk-On Assets & Weights")
msi_qqq_value                           = input.string("NDX", "", inline = "4.0", group = "Risk-On Assets & Weights")
msi_qqq_weight                          = input.float(1.2, title="", minval=0.1, maxval=3.0, step=0.1, inline="4.0", group = "Risk-On Assets & Weights", tooltip = "Include NASDAQ-100 (QQQ) as tech risk proxy")
msi_use_iwm                             = input.bool(true, title="IWM Weight       ", inline="5.0", group = "Risk-On Assets & Weights")
msi_iwm_value                           = input.string("IWM", "", inline = "5.0", group = "Risk-On Assets & Weights")
msi_iwm_weight                          = input.float(1.0, title="", minval=0.1, maxval=3.0, step=0.1, inline="5.0", group = "Risk-On Assets & Weights", tooltip = "Include Russell 2000 (IWM) for small-cap risk appetite")
msi_use_copper                          = input.bool(true, title="HG Weight         ", inline="6.0", group = "Risk-On Assets & Weights")
msi_copper_value                        = input.string("HG1!", "", inline = "6.0", group = "Risk-On Assets & Weights")
msi_copper_weight                       = input.float(1.1, title="", minval=0.1, maxval=3.0, step=0.1, inline="6.0", group = "Risk-On Assets & Weights", tooltip = "Include Copper (HG1!) as industrial demand proxy")
msi_use_soxx                            = input.bool(true, title="SOXX Weight     ", inline="7.0", group = "Risk-On Assets & Weights")
msi_soxx_value                          = input.string("SOXX", "", inline = "7.0", group = "Risk-On Assets & Weights")
msi_soxx_weight                         = input.float(1.1, title="", minval=0.1, maxval=3.0, step=0.1, inline="7.0", group = "Risk-On Assets & Weights", tooltip = "Include Semiconductors (SOXX) as forward-looking sector")
msi_use_btc                             = input.bool(true, title="BTC Weight       ", inline="8.0", group = "Risk-On Assets & Weights")
msi_btc_value                           = input.string("BTCUSD", "", inline = "8.0", group = "Risk-On Assets & Weights")
msi_btc_weight                          = input.float(1.0, title="", minval=0.1, maxval=3.0, step=0.1, inline="8.0", group = "Risk-On Assets & Weights", tooltip = "Include Bitcoin (BTCUSD) as liquidity/risk proxy")

// Risk-Off / Defensive Assets
msi_use_vix                             = input.bool(true, title="VIX Weight        ", inline="1.0", group = "Risk-Off & Defensive")
msi_vix_value                           = input.string("VIX", "", inline = "1.0", group = "Risk-Off & Defensive")
msi_vix_weight                          = input.float(1.5, title="", minval=0.1, maxval=3.0, step=0.1, inline="1.0", group = "Risk-Off & Defensive", tooltip = "Include VIX Volatility")
msi_use_put_call                        = input.bool(true, title="P/C Weight        ", inline="2.0", group = "Risk-Off & Defensive")
msi_put_call_value                      = input.string("PC", "", inline = "2.0", group = "Risk-Off & Defensive")
msi_put_call_weight                     = input.float(1.0, title="", minval=0.1, maxval=3.0, step=0.1, inline="2.0", group = "Risk-Off & Defensive", tooltip = "Include Put/Call Ratio")
msi_use_gold                            = input.bool(true, title="GC Weight        ", inline="3.0", group = "Risk-Off & Defensive")
msi_gold_value                          = input.string("GC1!", "", inline = "3.0", group = "Risk-Off & Defensive")
msi_gold_weight                         = input.float(0.8, title="", minval=0.1, maxval=3.0, step=0.1, inline="3.0", group = "Risk-Off & Defensive", tooltip = "Include Gold (GC1!)")
msi_use_tlt                             = input.bool(true, title="TLT Weight       ", inline="4.0", group = "Risk-Off & Defensive")
msi_tlt_value                           = input.string("TLT", "", inline = "4.0", group = "Risk-Off & Defensive")
msi_tlt_weight                          = input.float(1.2, title="", minval=0.1, maxval=3.0, step=0.1, inline="4.0", group = "Risk-Off & Defensive", tooltip = "Include Long-Term Treasuries (TLT)")
msi_use_usdjpy                          = input.bool(false, title="JPY Weight       ", inline="5.0", group = "Risk-Off & Defensive")
msi_usdjpy_value                        = input.string("USDJPY", "", inline = "5.0", group = "Risk-Off & Defensive")
msi_usdjpy_weight                       = input.float(1.1, title="", minval=0.1, maxval=3.0, step=0.1, inline="5.0", group = "Risk-Off & Defensive", tooltip = "Use USD/JPY as risk-off currency")
msi_use_usdchf                          = input.bool(false, title="CHF Weight      ", inline="6.0", group = "Risk-Off & Defensive")
msi_usdchf_value                        = input.string("USDCHF", "", inline = "6.0", group = "Risk-Off & Defensive")
msi_usdchf_weight                       = input.float(1.1, title="", minval=0.1, maxval=3.0, step=0.1, inline="6.0", group = "Risk-Off & Defensive", tooltip = "Use USD/CHF as defensive FX proxy")
msi_use_xlu                             = input.bool(true, title="XLU Weight       ", inline="7.0", group = "Risk-Off & Defensive")
msi_xlu_value                           = input.string("XLU", "", inline = "7.0", group = "Risk-Off & Defensive")
msi_xlu_weight                          = input.float(0.9, title="", minval=0.1, maxval=3.0, step=0.1, inline="7.0", group = "Risk-Off & Defensive", tooltip = "Include Utilities ETF (XLU)")
msi_use_xly                             = input.bool(true, title="XLY Weight       ", inline="8.0", group = "Risk-Off & Defensive")
msi_xly_value                           = input.string("XLY", "", inline = "8.0", group = "Risk-Off & Defensive")
msi_xly_weight                          = input.float(1.3, title="", minval=0.1, maxval=3.0, step=0.1, inline="8.0", group = "Risk-Off & Defensive", tooltip = "Include Utilities ETF (XLU)")
msi_use_defensive_ratio                 = input.bool(true, title="XLU/XLY Ratio    ", inline="9.0", group = "Risk-Off & Defensive")
msi_defensive_ratio_weight              = input.float(1.3, title="", minval=0.1, maxval=3.0, step=0.1, inline="9.0", group = "Risk-Off & Defensive", tooltip = "Use Utilities / Consumer Discretionary ratio")

// Macro & Rates
msi_use_yield                           = input.bool(true, title="TNX Weight       ", inline="1.0", group = "Macro & Interest Rate")
msi_yield_value                         = input.string("TNX", "", inline = "1.0", group = "Macro & Interest Rate")
msi_yield_weight                        = input.float(1.0, title="", minval=0.1, maxval=3.0, step=0.1, inline="1.0", group = "Macro & Interest Rate", tooltip = "Include 10Y Treasury Yield (TNX)")
msi_use_yield_curve                     = input.bool(true, title="Yield Weight      ", inline="2.0", group = "Macro & Interest Rate")
msi_yield_curve_value                   = input.string("TYX", "", inline = "2.0", group = "Macro & Interest Rate")
msi_yield_curve_weight                  = input.float(1.4, title="", minval=0.1, maxval=3.0, step=0.1, inline="2.0", group = "Macro & Interest Rate", tooltip = "Include 10Y-2Y Spread")
msi_use_usd                             = input.bool(true, title="DXY Weight       ", inline="3.0", group = "Macro & Interest Rate")
msi_usd_value                           = input.string("DXY", "", inline = "3.0", group = "Macro & Interest Rate")
msi_usd_weight                          = input.float(1.1, title="", minval=0.1, maxval=3.0, step=0.1, inline="3.0", group = "Macro & Interest Rate", tooltip = "Include USD Index (DXY)")
msi_use_bci                             = input.bool(true, title="BCI Weight        ", inline="4.0", group = "Macro & Interest Rate")
msi_bci_value                           = input.string("AW", "", inline = "4.0", group = "Macro & Interest Rate")
msi_bci_weight                          = input.float(0.7, title="", minval=0.1, maxval=3.0, step=0.1, inline="4.0", group = "Macro & Interest Rate", tooltip = "Include Bloomberg Commodity Index (BCOM)")
// msi_use_m2                              = input.bool(true, title="M2 Weight        ", inline="5.0", group = "Macro & Interest Rate")
// msi_m2_value                            = input.string("USM2", "", inline = "5.0", group = "Macro & Interest Rate")
