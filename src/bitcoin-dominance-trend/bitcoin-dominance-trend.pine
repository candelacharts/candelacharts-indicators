//@version=6
indicator(title="CandelaCharts - Bitcoin Dominance Trend", shorttitle="CandelaCharts - Bitcoin Dominance Trend", overlay=false, max_bars_back=500)












// # ========================================================================= #
// # |   Colors   |
// # ========================================================================= #

//#region

// Core
colors_white          = color.white
colors_black          = color.black
colors_gray           = color.gray
colors_teal           = color.teal
colors_blue           = color.blue
colors_orange         = color.orange
colors_green          = color.green
colors_red            = color.red
color_transparent     = #00000000

// Custom
colors_cyan_dark      = #089981
colors_red_bright     = #f23645
colors_purple_dark    = #7E57C2

//#endregion

// # ========================================================================= #
// # |   End   |
// # ========================================================================= #












// # ========================================================================= #
// # |   Inputs   |
// # ========================================================================= #

//#region

// # General ----------------------------------------------------------------- #

general_font          = input.string("Monospace", "Text               ", options=["Default", "Monospace"], inline="1.0", group="General")
general_text          = input.string("Tiny", "", options=["Tiny", "Small", "Normal", "Large", "Huge", "Auto"], inline="1.0", group="General", tooltip="Text size")
general_brand_show    = input.bool(false, "Hide Brand", group="General")

// # BDT --------------------------------------------------------------------- #

bdt_line_bullish_color = input.color(colors_teal, "Dominance        ", inline="0.0", group="Settings")
bdt_line_bearish_color = input.color(colors_orange, "", inline="0.0", group="Settings")
bdt_ma_length          = input.int(100, "MA Length        ", minval=5, maxval=200, inline="1.0", group="Settings")
bdt_ma_type            = input.string("EMA", "MA Type           ", options=["SMA", "EMA", "RMA", "WMA", "VWMA"], inline="2.0", group="Settings")
bdt_ma_line_width      = input.int(2, "MA Line           ", minval=0, maxval=5, inline="3.0", group="Settings")
bdt_ma_line_color      = input.color(color.new(colors_gray, 50), "", inline="3.0", group="Settings")
bdt_btc_dominance_symbol = input.symbol("CRYPTOCAP:BTC.D", "Symbol           ", inline="4.0", group="Settings")

//#endregion

// # ========================================================================= #
// # |   End   |
// # ========================================================================= #












// # ========================================================================= #
// # |   Functions   |
// # ========================================================================= #

//#region

text_size(size) =>
    switch size
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        "Huge"   => size.huge
        => size.auto

font_family(font) =>
    switch font
        "Default"   => font.family_default
        "Monospace" => font.family_monospace

//#endregion

// # ========================================================================= #
// # |   End   |
// # ========================================================================= #












// # ========================================================================= #
// # |   Variables   |
// # ========================================================================= #

//#region

// Key Levels
level_40 = 40.0
level_65 = 65.0

//#endregion

// # ========================================================================= #
// # |   End   |
// # ========================================================================= #












// # ========================================================================= #
// # |   BTC Dominance Calculation   |
// # ========================================================================= #

//#region

// Get daily BTC.D close (non-repainting)
dom = request.security(bdt_btc_dominance_symbol, "D", close[barstate.isrealtime ? 0 : 1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

// Moving Average
ma = switch bdt_ma_type
    "SMA" => ta.sma(dom, bdt_ma_length)
    "EMA" => ta.ema(dom, bdt_ma_length)
    "WMA" => ta.wma(dom, bdt_ma_length)
    "VWMA" => ta.vwma(dom, bdt_ma_length)
    "RMA" => ta.rma(dom, bdt_ma_length)
    => na

// Plot BTC.D line with color based on MA
dom_color = dom >= ma ? bdt_line_bullish_color : bdt_line_bearish_color
plot(dom, "BTC Dominance", color=dom_color, linewidth=bdt_ma_line_width)
plot(ma, "Trend MA", color=bdt_ma_line_color, linewidth=2)

// Horizontal levels
hline_low = hline(level_40, "Level 40%", color=color.new(colors_blue, 70), linestyle=hline.style_dashed)
hline(50, "Level 50%", color=color.new(colors_gray, 60), linestyle=hline.style_dashed)
hline_up = hline(level_65, "Level 65%", color=color.new(colors_orange, 70), linestyle=hline.style_dashed)
fill(hline_up, hline_low, color=color.new(color.blue, 95), title="Background", display = display.all)

// Background color zones — only one active at a time
bgcolor_color = 
     dom < level_40  ? color.new(colors_red, 92) :
     dom > level_65  ? color.new(colors_green, 92) :
                       color.new(colors_gray, 100)

bgcolor(bgcolor_color, title="Background Zone")

// Highlight Last MA Cross Below
var label last_cross_below = na

if dom < ma
    if not na(last_cross_below)
        label.delete(last_cross_below)
    last_cross_below := label.new(
         bar_index, dom,
         text = "",
         color = color.new(colors_red, 90),
         textcolor = colors_white,
         style = label.style_circle,
         size = size.large,
         xloc = xloc.bar_index,
         yloc = yloc.price)
else
    na

// # ========================================================================= #
// # |   Alerts   |
// # ========================================================================= #

alertcondition(ta.crossover(dom, ma), title="BTC Dominance Cross Above MA", message="BTC Dominance crossed ABOVE its moving average.")
alertcondition(ta.crossunder(dom, ma), title="BTC Dominance Cross Below MA", message="BTC Dominance crossed BELOW its moving average.")
alertcondition(ta.crossover(dom, level_65), title="BTC Dominance Entered Extreme High (>65%)", message="BTC Dominance crossed above 65%.")
alertcondition(ta.crossunder(dom, level_40), title="BTC Dominance Entered Altseason Zone (<40%)", message="BTC Dominance crossed below 40%.")

//#endregion

// # ========================================================================= #
// # |   End   |
// # ========================================================================= #












// # ========================================================================= #
// # |   Brand Label   |
// # ========================================================================= #

//#region

if barstate.isfirst and general_brand_show == false
    var table brand_table = table.new(position.bottom_right, 1, 1, bgcolor=chart.bg_color)
    table.cell(brand_table, 0, 0, "© CandelaCharts", text_color=color.new(colors_gray, 30),
               text_halign=text.align_center, text_size=text_size(general_text),
               text_font_family=font_family(general_font))
//#endregion

// # ========================================================================= #
// # |   End   |
// # ========================================================================= #
