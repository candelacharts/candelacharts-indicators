// # ========================================================================= #
// # |   Functions   |
// # ========================================================================= #

//#region

method text_size(string size) =>
    out = switch size
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        "Huge"   => size.huge
        "Auto"   => size.auto
    out

method line_style(string style) =>
    out = switch style
        '⎯⎯⎯'  => line.style_solid
        '----'   => line.style_dashed
        '····'   => line.style_dotted

method font_style(string font) =>
    out = switch font
        'Default'   => font.family_default
        'Monospace' => font.family_monospace

is_dark() =>
    bg_color = chart.bg_color

    r = color.r(bg_color)
    g = color.g(bg_color)
    b = color.b(bg_color)
    luminosity = r + g + b
    is_dark = luminosity <= 383

    is_dark

//#endregion

// # ========================================================================= #
// # |   End   |
// # ========================================================================= #











// # ========================================================================= #
// # |   Algorithm   |
// # ========================================================================= #

//#region

// Helper: normalized series (indexed to 100 from first bar on/after from_date)
f_indexed(sym, cond) =>
    float c = na
    if cond
        c := request.security(sym, timeframe.period, close, ignore_invalid_symbol=true)
        if barstate.islast and na(c)
            log.error("Data missing or invalid ticker: " + sym)
    startCond = time >= from_date and not na(c)
    firstBar  = startCond and not startCond[1]
    base      = ta.valuewhen(firstBar, c, 0)
    base := na(base) ? ta.valuewhen(not na(c), c, 0) : base
    c / base * 100

// Series
ndx   = f_indexed(sym_NDX, show_NDX)
spx   = f_indexed(sym_SPY, show_SPY)
acwi  = f_indexed(sym_ACWI, show_ACWI)
tlt   = f_indexed(sym_TLT, show_TLT)
cash  = f_indexed(sym_CASH, show_CASH)
hyg   = f_indexed(sym_HYG, show_HYG)
gold  = f_indexed(sym_GLD, show_GLD)
oil   = f_indexed(sym_USO, show_USO)
dxy   = f_indexed(sym_DXY, show_DXY)
btc   = f_indexed(sym_BTC, show_BTC)
eth   = f_indexed(sym_ETH, show_ETH)
m2    = f_indexed(sym_M2, show_M2)   // monthly; steps on lower TFs

// Colors
col_NDX  = color_NDX
col_SPY  = color_SPY
col_ACWI = color_ACWI
col_TLT  = color_TLT
col_CASH = color_CASH
col_HYG  = color_HYG
col_GLD  = color_GLD
col_USO  = color_USO
col_DXY  = color_DXY
col_BTC  = color_BTC
col_ETH  = color_ETH
col_M2   = color_M2

// Plots (global only)
plot(show_NDX  ? ndx  : na, title="NASDAQ 100 (QQQ)",          color=col_NDX,  linewidth=2)
plot(show_SPY  ? spx  : na, title="S&P 500 (SPY)",             color=col_SPY,  linewidth=2)
plot(show_ACWI ? acwi : na, title="Global Equities (ACWI)",    color=col_ACWI, linewidth=2)
plot(show_TLT  ? tlt  : na, title="US Treasuries Long (TLT)",  color=col_TLT,  linewidth=2)
plot(show_CASH ? cash : na, title="T-Bills / Cash",            color=col_CASH, linewidth=2)
plot(show_HYG  ? hyg  : na, title="High Yield Bonds (HYG)",    color=col_HYG,  linewidth=2)
plot(show_GLD  ? gold : na, title="Gold (GLD)",                color=col_GLD,  linewidth=2)
plot(show_USO  ? oil  : na, title="Oil (USO)",                 color=col_USO,  linewidth=2)
plot(show_DXY  ? dxy  : na, title="US Dollar Index (DXY)",     color=col_DXY,  linewidth=2)
plot(show_BTC  ? btc  : na, title="Bitcoin (BTC)",             color=col_BTC,  linewidth=2)
plot(show_ETH  ? eth  : na, title="Ethereum (ETH)",            color=col_ETH,  linewidth=2)
plot(show_M2   ? m2   : na, title="US M2 Money Supply",        color=col_M2,   linewidth=2)
plot(show_base ? 100  : na, title="Base = 100",                color=color.new(color.gray, 50))

// Label text helper (one decimal)
f_valtxt(name, v) =>
    name + " " + str.tostring(math.round(v * 10.0) / 10.0)

// Persistent labels (one per asset)
var label l_NDX  = na
var label l_SPY  = na
var label l_ACWI = na
var label l_TLT  = na
var label l_CASH = na
var label l_HYG  = na
var label l_GLD  = na
var label l_USO  = na
var label l_DXY  = na
var label l_BTC  = na
var label l_ETH  = na
var label l_M2   = na

// Update helper (no argument mutation)
f_upd_label(lbl, show, y, name, bg, txtcol) =>
    label res = lbl
    if barstate.islast
        if show and not na(y)
            if na(res)
                res := label.new(bar_index, y, f_valtxt(name, y),
                                 xloc=xloc.bar_index, yloc=yloc.price,
                                 style=label.style_label_left, textcolor=txtcol,
                                 color=color.new(bg, 0), size=size.small)
            else
                label.set_xy(res, bar_index, y)
                label.set_text(res, f_valtxt(name, y))
                label.set_color(res, color.new(bg, 0))
                label.set_textcolor(res, txtcol)
        else
            if not na(res)
                label.delete(res)
                res := na
    res

// Update labels on last bar
l_NDX  := f_upd_label(l_NDX,  show_NDX,  ndx,  "NASDAQ 100", col_NDX,  color.white)
l_SPY  := f_upd_label(l_SPY,  show_SPY,  spx,  "S&P 500",    col_SPY,  color.white)
l_ACWI := f_upd_label(l_ACWI, show_ACWI, acwi, "Global Eq.",  col_ACWI, color.white)
l_TLT  := f_upd_label(l_TLT,  show_TLT,  tlt,  "US Treas.",   col_TLT,  color.white)
l_CASH := f_upd_label(l_CASH, show_CASH, cash, "T-Bills",     col_CASH, color.white)
l_HYG  := f_upd_label(l_HYG,  show_HYG,  hyg,  "High Yield",  col_HYG,  color.white)
l_GLD  := f_upd_label(l_GLD,  show_GLD,  gold, "Gold",        col_GLD,  color.black)
l_USO  := f_upd_label(l_USO,  show_USO,  oil,  "Oil",         col_USO,  color.white)
l_DXY  := f_upd_label(l_DXY,  show_DXY,  dxy,  "DXY",         col_DXY,  color.white)
l_BTC  := f_upd_label(l_BTC,  show_BTC,  btc,  "BTC",         col_BTC,  color.white)
l_ETH  := f_upd_label(l_ETH,  show_ETH,  eth,  "ETH",         col_ETH,  color.white)
l_M2   := f_upd_label(l_M2,   show_M2,   m2,   "US M2",       col_M2,   color.black)

//#endregion

