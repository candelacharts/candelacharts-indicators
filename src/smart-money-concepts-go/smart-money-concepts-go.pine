//#region

// NOTE: Moving this section will result on following ERROR: Error at 646:1 built-in 'line.set_color' cannot be used with any parameter of the `security()` function.

method scanner_table_cell_header(series table scanner_table, int column, int row, string txt) =>
    text_color = color.black
    table.cell(scanner_table, column = column, row = row, text = txt, text_halign = text.align_center, text_size = text_size(general_text), text_color = text_color, bgcolor = chart.bg_color, text_font_family = font_style(general_font), width = general_text == "Large" ? na : 2)

method scanner_table_cell_value(series table scanner_table, int column, int row, UDT_Scanner data) =>
    text_color = data.is_bullish ? ms_internal_up_bos.darkcss(-0.25, true) : data.is_bearish ? ms_internal_down_bos.darkcss(0.25, false) : color.gray
    txt = data.value_f
    table.cell(scanner_table, column = column, row = row, text = txt, text_halign = text.align_center, text_size = text_size(general_text), text_color = text_color, bgcolor = chart.bg_color, text_font_family = font_style(general_font), width = general_text == "Large" ? na : 6)

method scanner_table(series table scanner_table, array<string> columns, map<string, UDT_Scanner> data) => 
    scanner_table.set_frame_color(color.gray)
    scanner_table.set_frame_width(1)
    scanner_table.set_border_color(color.black)
    scanner_table.set_border_width(1)

    for [index, key] in columns
        scanner_table.scanner_table_cell_header(column = index, row = 1, txt = key)
    
    for [index, key] in data.keys()
        scanner_table.scanner_table_cell_header(column = 0, row = index + 2, txt  = key)
        scanner_table.scanner_table_cell_value (column = 1, row = index + 2, data = data.get(key))
    scanner_table

// # MTF Scanner ------------------------------------------------------------- #

if scanner_mtf_show

    scanner_mtf_columns = array.from("TIME", "TREND")

    [i_trend_5 ]  = request.security("", "5"  , [internal_trend])
    [i_trend_15]  = request.security("", "15" , [internal_trend])
    [i_trend_30]  = request.security("", "30" , [internal_trend])
    [i_trend_1h]  = request.security("", "60" , [internal_trend])
    [i_trend_4h]  = request.security("", "240", [internal_trend])
    [i_trend_1d]  = request.security("", "1D" , [internal_trend])

    scanner_mtf_data = map.new<string, UDT_Scanner>()
    scanner_mtf_data.put("5m"   , mtf_value(i_trend_5))
    scanner_mtf_data.put("15m"  , mtf_value(i_trend_15))
    scanner_mtf_data.put("30m"  , mtf_value(i_trend_30))
    scanner_mtf_data.put("1h"   , mtf_value(i_trend_1h))
    scanner_mtf_data.put("4h"   , mtf_value(i_trend_4h))
    scanner_mtf_data.put("D"    , mtf_value(i_trend_1d))

    var scanner_mtf_table = table.new(position = table_position(scanner_mtf_position), columns = 20, rows = 20)
    if (barstate.islast)
        scanner_mtf_table.scanner_table(columns = scanner_mtf_columns, data = scanner_mtf_data)

//#endregion

