//#region

if ms_enable
    internal_ms.draw_ms()
    swing_ms.draw_ms()

//#region pivot points

detect_pivot_points(int len) =>
    [hH, lL] = request.security(syminfo.tickerid, blocks_timeframe, [high, low], lookahead = barmerge.lookahead_off)

    h = array.new<float>()
    l = array.new<float>()
    n = array.new< int >()

    if len > 1
        for i = 0 to len - 1
            h.push(hH[i])
            l.push(lL[i])
            n.push(b_t[i])
    
        float highest_high = h.max()
        float lowest_low   = l.min()
        int i_highest_high = h.indexof(highest_high) + 1
        int i_lowest_low   = l.indexof(lowest_low) + 1
        int highest_high_n = n.get(i_highest_high - 1)
        int lowest_low_n   = n.get(i_lowest_low - 1) 
        UDT_Pivot_Point pivot_point = UDT_Pivot_Point.new(
               highest_high = highest_high
             , lowest_low = lowest_low
             , highest_high_n = highest_high_n
             , lowest_low_n = lowest_low_n
             , i_highest_high = i_highest_high
             , i_lowest_low = i_lowest_low
             )

        pivot_point

//#endregion

//#region order blocks

method style_order_block(UDT_Block order_block, box figure, bool swing, bool inversion) =>
    bull      = inversion ? not order_block.bull : order_block.bull
    mitigated = order_block.mitigated
    breaker   = order_block.breaker

    bgcolor = mitigated
         ? blocks_mitigation_css
         : blocks_use_grayscale
             ? colors_gray_90 
             : bull 
                 ? swing ? blocks_bull_css : breaker ? blocks_bull_css.set_opacity(90) : blocks_bull_css 
                 : swing ? blocks_bear_css : breaker ? blocks_bear_css.set_opacity(90) : blocks_bear_css
    figure.set_bgcolor(bgcolor)
    figure.set_text_size(size.auto)
    figure.set_text_halign(text.align_left)
    figure.set_text_font_family(font_style(general_font))
    figure.set_text_color(colors_gray)
    use_border = swing or blocks_use_border
    figure.set_border_color(use_border ? blocks_use_grayscale ? colors_gray : bgcolor : colors_transparent)
    figure.set_border_style(line_style(blocks_use_border_type))
    figure.set_border_width(use_border ? blocks_use_border_width : 0)
    figure

style_metric_block(box figure, bool bull, bool swing) =>
    bgcolor = bull ? blocks_metric_bull_css : blocks_metric_bear_css
    figure.set_extend(extend.none)
    figure.set_bgcolor(bgcolor)
    figure.set_text_size(size.auto)
    figure.set_text_font_family(font_style(general_font))
    figure.set_border_color(bgcolor)
    figure.set_border_style(line_style(blocks_use_border_type))
    figure.set_border_width(0)
    figure

method style_order_block_midline(UDT_Block order_block, line figure, bool swing) =>
    bull    = order_block.bull
    lncolor = bull 
             ? swing ? blocks_bull_css : blocks_bull_css 
             : swing ? blocks_bear_css : blocks_bear_css
    figure.set_color(blocks_use_grayscale ? colors_gray : lncolor.set_opacity(5))
    figure.set_width(blocks_use_middle_line_width)
    figure.set_style(line_style(blocks_use_middle_line_type))
    figure

get_block_position(bool bull) =>
    pos = switch blocks_position
        "Full"      => bull ? high : low
        "Middle"    => ohlc4
        "Accurate"  => hl2
        "Precise"   => hl2
        => hl2
    pos

method detect_order_block(array<UDT_Block> order_blocks, UDT_Pivot_Point pivot_point, bool cdn, bool bull) =>
    UDT_Block ob = na

    position = get_block_position(bull)

    if cdn and not na(pivot_point)
        id        = b.n
        bar_close = bull ? b_c[pivot_point.i_lowest_low]   : b_c[pivot_point.i_highest_high]
        bar_open  = bull ? b_o[pivot_point.i_lowest_low]   : b_o[pivot_point.i_highest_high]
        pos       = bull ? position[pivot_point.i_lowest_low]   : position[pivot_point.i_highest_high] 
        prev_high = bull ? hlcc4[pivot_point.i_lowest_low] : hlcc4[pivot_point.i_highest_high]

        switch bull
            true =>
                left    = pivot_point.lowest_low_n
                top     = pos
                right   = last_bar_time
                bottom  = pivot_point.lowest_low
                mid     = math.avg(top, bottom)

                switch blocks_position
                    "Precise" => 
                        if mid < (bar_close < bar_open ? bar_close : bar_open) and top > prev_high
                            top := mid
                            mid := math.avg(top, bottom)
                ob := UDT_Block.new(id, left, top, right, bottom, mid, bull = bull, state = 0)

            false =>
                left    = pivot_point.highest_high_n
                top     = pivot_point.highest_high
                right   = last_bar_time
                bottom  = pos
                mid     = math.avg(top, bottom)

                switch blocks_position
                    "Precise" => 
                        if mid > (bar_close < bar_open ? bar_open : bar_close) and bottom < prev_high
                            bottom := mid
                            mid := math.avg(top, bottom)

                ob := UDT_Block.new(id, left, top, right, bottom, mid, bull = bull, state = 0)
        
        order_blocks.unshift(ob)

    ob

method add_block_volume(map<int, UDT_Volume> order_volume, UDT_Block order_block, UDT_Pivot_Point pivot_point) =>
    if not na(order_block)
        bull      = order_block.bull
        bar_close = bull ? b_c[pivot_point.i_lowest_low]   : b_c[pivot_point.i_highest_high]
        bar_open  = bull ? b_o[pivot_point.i_lowest_low]   : b_o[pivot_point.i_highest_high]
        vol       = bull ? b_v[pivot_point.i_lowest_low] : b_v[pivot_point.i_highest_high]
        vol_dir   = bar_close > bar_open
        ob_id     = order_block.id

        vb = UDT_Volume.new(ob_id = ob_id, vol = vol, vol_percent = 0, dir = vol_dir, wM = 1, blVP = 0, brVP = 0)
        order_volume.put(ob_id, vb)

    order_volume

method invalidate_blocks(array<UDT_Block> order_blocks, float close_price) =>
    if order_blocks.size() > 0
        for i = order_blocks.size()-1 to 0
            ob = order_blocks.get(i)
            if (ob.bull ? close_price < ob.bottom : close_price > ob.top)
                ob.invalidated := true
                order_blocks.remove(i)
    order_blocks

method add_buy_sell_activity(map<int, UDT_Volume> order_volume) => 
    for [i, ob] in order_volume
        switch ob.dir

            true  =>
                switch ob.wM

                    1 => ob.blVP := ob.blVP + 1, ob.wM := 2
                    2 => ob.blVP := ob.blVP + 1, ob.wM := 3
                    3 => ob.brVP := ob.brVP + 1, ob.wM := 1
            false =>
                switch ob.wM

                    1 => ob.brVP := ob.brVP + 1, ob.wM := 2
                    2 => ob.brVP := ob.brVP + 1, ob.wM := 3
                    3 => ob.blVP := ob.blVP + 1, ob.wM := 1
    order_volume

method remove_overlaped_blocks(array<UDT_Block> order_blocks) =>
    int size = array.size(order_blocks)
    int i = 0
    while i < size
        int j = i + 1
        while j < size
            // Get the blocks
            bl_1 = array.get(order_blocks, i)
            bl_2 = array.get(order_blocks, j)

            // Check for overlap between bl_1 and bl_2
            if bl_1.bull == bl_2.bull // Only compare blocks of the same type (bull or bear)
                // Check if the blocks overlap
                if (bl_1.top > bl_2.bottom and bl_1.bottom < bl_2.top)
                    // Remove the more recent block (higher index) and adjust size
                    order_blocks.remove(j)
                    size := size - 1  // Update the size after removal
                    j := j - 1  // Adjust j since we removed an element
            j := j + 1
        i := i + 1

    // Return the updated array without overlapped blocks
    order_blocks

method get_total_volume(array<UDT_Block> order_blocks, map<int, UDT_Volume> order_volume) =>
    vol_arr = array.new<float>()
    
    for [index, ob] in order_blocks
        vol = order_volume.get(ob.id)
        vol_arr.unshift(vol.vol)

    float total = vol_arr.sum()
    total

method add_volume_percentage(array<UDT_Block> order_blocks, map<int, UDT_Volume> order_volume) =>
    float total = order_blocks.get_total_volume(order_volume)
    float total_percent = 100
    
    for [index, ob] in order_blocks
        vol = order_volume.get(ob.id)
        if (index < order_blocks.size() - 1)
            p = calc_percentage(vol.vol, total)
            total_percent -= p
            vol.vol_percent := p
        else
            vol.vol_percent := total_percent

    order_volume

method limit_filter_bull_or_bear(array<UDT_Block> order_blocks, bool only_bull, int limit) =>
    filter_blocks       = array.new<UDT_Block>()
    len   = math.min(limit, order_blocks.size())
    i = 0
    count = 0
    while i < order_blocks.size() and count < len
        ob = order_blocks.get(i)
        if ob.bull == only_bull
            filter_blocks.unshift(ob)
            count += 1
        i += 1
    filter_blocks

method draw_volumetric_order_blocks(array<UDT_Block> order_blocks, map<int, UDT_Volume> order_volume, int cur_time, int prev_time, bool swing) => 
    for [i, ob] in order_blocks
        time_frame = cur_time - prev_time
        top     = ob.top
        bottom  = ob.bottom
        left    = ob.left
        right   = last_bar_time // ob.right
        rightShift = cur_time + time_frame * 100
        mid     = ob.mid
        bull    = ob.bull
        mitigated  = ob.mitigated

        bin.ob_box.push(ob.style_order_block(box.new(left = left, top = top, right = right, bottom = bottom, xloc = xloc.bar_time, extend = blocks_show_metrics ? extend.none : extend.right), swing, false))

        if blocks_use_middle_line
            bin.ob_ln.push(ob.style_order_block_midline(line.new(x1 = left, y1 = mid, x2 = right, y2 = mid, xloc = xloc.bar_time, extend = blocks_show_metrics ? extend.none : extend.right), swing))

        // volume
        ob_vol  = order_volume.get(ob.id)

        if blocks_show_metrics
            extended_ob = ob.style_order_block(box.new(left = cur_time, top = top, right = rightShift, bottom = bottom, xloc = xloc.bar_time, extend = extend.right), swing, false)
            bin.ob_box.push(extended_ob)
            extended_ob.add_volume_label(ob_vol.vol, ob_vol.vol_percent / 100)

        if blocks_show_buy_sell_activity
            bin.ob_box.push(style_metric_block(box.new(left = left, top = top, right = left + time_frame * ob_vol.blVP, bottom = mid, xloc = xloc.bar_time), true, swing))
            bin.ob_box.push(style_metric_block(box.new(left = left, top = mid, right = left + time_frame * ob_vol.brVP, bottom = bottom, xloc = xloc.bar_time), false, swing))

    order_blocks

//#endregion

var hN = b.n
var lN = b.n
var hS = b.n
var lS = b.n

if not na(iH)

    hN:=int(b_n[internal_ms_length])

if not na(iL)

    lN:=int(b_n[internal_ms_length])

if not na(sH)

    hS:=int(b_n[swing_ms_length])

if not na(sL)

    lS:=int(b_n[swing_ms_length])

bin.clean_ob()

order_blocks_indicator() => 
    
    var all_order_blocks = array.new<UDT_Block>(na) // order blocks
    var all_order_volume = map.new<int, UDT_Volume>() // order blocks volume

    bull_pivot_point = detect_pivot_points(math.abs((hN - b.n)))
    bull_vob = all_order_blocks.detect_order_block(bull_pivot_point, internal_ms.is_bull_ob, true)
    all_order_volume.add_block_volume(bull_vob, bull_pivot_point)

    bear_pivot_point = detect_pivot_points(math.abs((lN - b.n)))
    bear_vob = all_order_blocks.detect_order_block(bear_pivot_point, internal_ms.is_bear_ob, false)
    all_order_volume.add_block_volume(bear_vob, bear_pivot_point)

    if barstate.isconfirmed
            
        all_order_blocks.invalidate_blocks(close) // invalidate order blocks

        all_order_blocks.mitigate_imbalances(blocks_mitigation, b.c, low, high, time) // mitigate order blocks
        
        if blocks_show_buy_sell_activity
            all_order_volume.add_buy_sell_activity()

    if barstate.islast
        
        if blocks_use_overlap
            all_order_blocks.remove_overlaped_blocks() // remove overlaped

        bull_order_blocks = all_order_blocks.limit_filter_bull_or_bear(true , blocks_num)  // filter out bullish order blocks
        bear_order_blocks = all_order_blocks.limit_filter_bull_or_bear(false, blocks_num) // filter out bearish order blocks

        // calculate volume percentage for labels
        if blocks_show_metrics
            bull_order_blocks.add_volume_percentage(all_order_volume)
            bear_order_blocks.add_volume_percentage(all_order_volume)
    
        // add drawings
        bull_order_blocks.draw_volumetric_order_blocks(all_order_volume, b.t, b_t[1], false)
        bear_order_blocks.draw_volumetric_order_blocks(all_order_volume, b.t, b_t[1], false)

    // alerts
    bull_alert.enable_ob_alerts(bull_vob)
    bear_alert.enable_ob_alerts(bear_vob)

    [bull_vob, bear_vob]

swing_order_blocks_indicator() => 
    
    var all_order_blocks = array.new<UDT_Block>(na) // order blocks
    var all_order_volume = map.new<int, UDT_Volume>() // order blocks volume

    bull_pivot_point = detect_pivot_points(math.abs((hS - b.n)))
    bull_vob = all_order_blocks.detect_order_block(bull_pivot_point, swing_ms.is_bull_ob, true)
    all_order_volume.add_block_volume(bull_vob, bull_pivot_point)

    bear_pivot_point = detect_pivot_points(math.abs((lS - b.n)))
    bear_vob = all_order_blocks.detect_order_block(bear_pivot_point, swing_ms.is_bear_ob, false)
    all_order_volume.add_block_volume(bear_vob, bear_pivot_point)

    if barstate.isconfirmed
            
        all_order_blocks.invalidate_blocks(close) // invalidate order blocks
        all_order_blocks.mitigate_imbalances(blocks_mitigation, b.c, low, high, time) // mitigate order blocks
        
        if blocks_show_buy_sell_activity
            all_order_volume.add_buy_sell_activity()

    if barstate.islast
        
        if blocks_use_overlap
            all_order_blocks.remove_overlaped_blocks() // remove overlaped

        bull_order_blocks = all_order_blocks.limit_filter_bull_or_bear(true , blocks_num)  // filter out bullish order blocks
        bear_order_blocks = all_order_blocks.limit_filter_bull_or_bear(false, blocks_num) // filter out bearish order blocks

        // calculate volume percentage for labels
        if blocks_show_metrics
            bull_order_blocks.add_volume_percentage(all_order_volume)
            bear_order_blocks.add_volume_percentage(all_order_volume)
    
        // add drawings
        bull_order_blocks.draw_volumetric_order_blocks(all_order_volume, b.t, b_t[1], true)
        bear_order_blocks.draw_volumetric_order_blocks(all_order_volume, b.t, b_t[1], true)

    // alerts
    bull_alert.enable_swing_ob_alerts(bull_vob)
    bear_alert.enable_swing_ob_alerts(bear_vob)

    [bull_vob, bear_vob]

if blocks_show and blocks_type == "Order Blocks"

    order_blocks_indicator()

if blocks_show and blocks_type == "Swing Order Blocks"

    swing_order_blocks_indicator()

//#endregion

