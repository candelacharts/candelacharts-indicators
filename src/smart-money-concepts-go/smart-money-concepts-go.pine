alertcondition(bull_alert.chochplus        , "Bullish CHOCH+", "Bullish CHOCH+")
alertcondition(bull_alert.chochplusswing   , "Bullish Swing CHOCH+", "Bullish Swing CHOCH+")
alertcondition(bull_alert.chochswing       , "Bullish Swing CHOCH", "Bullish CHOCH")
alertcondition(bull_alert.swingbos         , "Bullish Swing BOS", "Bullish Swing BOS")
alertcondition(bull_alert.ehl              , "EQL", "EQL")
alertcondition(bull_alert.fvg              , "Bullish FVG", "Bullish FVG")
alertcondition(bull_alert.og               , "Bullish OG", "Bullish OG")
