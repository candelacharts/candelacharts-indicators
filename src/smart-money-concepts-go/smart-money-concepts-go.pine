// # ========================================================================= #
// # |   UDT   |
// # ========================================================================= #

//#region

type UDT_Bar
    float   o = open
    float   c = close
    float   h = high
    float   l = low
    float   v = volume
    int     n = bar_index
    int     t = time

type UDT_Zphl
    bool   scross
    bool   icross
    string txt
    float  x
    float  y
    float  t
    int    tx
    float  ix
    float  iy
    float  vol

type UDT_MS_PNL
	float[] p
	int  [] n
    float[] l

type UDT_MS
    int    trend
    bool   is_bull_ob
    bool   is_bear_ob
	int    x1
    int    x2
	float  p
    int    xloc
	color  css
	string ms_type
	bool   bull
    bool   swing
    bool   sweep

type UDT_EHL
    int    x1
    float  y1
    int    x2
    float  y2
    bool   bull

type UDT_Alerts
    // Market Structure
    bool chochswing     = false
    bool chochplusswing = false
    bool swingbos       = false
    bool chochplus      = false
    bool choch          = false
    bool bos            = false
    bool ehl            = false
    // Order Blocks
    bool ob             = false
    bool obtouch        = false
    bool swing_ob       = false
    // Imbalances
    bool fvg            = false
    bool og             = false

type UDT_Store
    line    [] ehl_ln
    label   [] ehl_lbl
    box     [] imbalance_box
    line    [] imbalance_ln
    box     [] ob_box
    line    [] ob_ln
    line    [] ms_ln
    label   [] ms_lbl
    line    [] hl_ln
    label   [] hl_lbl
    line    [] phl_ln
    label   [] phl_lbl
    box     [] phl_box
    
type UDT_Pivot_Point
    float highest_high
    float lowest_low
    int   lowest_low_n
    int   highest_high_n
    int   i_highest_high
    int   i_lowest_low

type UDT_Block
    int     id          = na
    int     left        = na
    float   top         = na
    int     right       = na
    float   bottom      = na
    float   mid         = na
    bool    bull        = false
    int     state       = na
    bool    breaker     = false
    int     x_inv_point = na
    bool    mitigated   = false
    bool    invalidated = false
    bool    alert_fired = false

type UDT_Volume
    int ob_id   = na
    float vol   = na
    float vol_percent = na
    int   wM    = na
    int   blVP  = na
    int   brVP  = na
    bool  dir   = false

type UDT_Scanner
    float   value
    string  value_f
    float   bullish_value
    float   bearish_value
    bool    is_bullish
    bool    is_bearish

type UDT_MTF
    int x1   = na
    int x2   = na
    float y1 = na
    float y2 = na

//#endregion

// # ========================================================================= #
// # |   End   |
// # ========================================================================= #











// # ========================================================================= #
// # |   Store   |
// # ========================================================================= #

//#region

var UDT_Store bin = UDT_Store.new(
                   ehl_ln = array.new<line>()
                 , ehl_lbl = array.new<label>()
                 , imbalance_box = array.new<box>()
                 , imbalance_ln  = array.new<line>()
                 , ob_box = array.new<box>()
                 , ob_ln  = array.new<line>()
                 , ms_ln  = array.new<line>()
                 , ms_lbl = array.new<label>()
                 , hl_ln = array.new<line>()
                 , hl_lbl = array.new<label>()
                 , phl_ln = array.new<line>()
                 , phl_lbl = array.new<label>()
                 , phl_box = array.new<box>()
                 )

method clean_ehl(UDT_Store store) =>
    for obj in store.ehl_ln
        obj.delete()
    for obj in store.ehl_lbl
        obj.delete()

    store.ehl_ln.clear()
    store.ehl_lbl.clear()

method clean_imbalance(UDT_Store store) =>
    for obj in store.imbalance_box
        obj.delete()
    for obj in store.imbalance_ln
        obj.delete()
        
    store.imbalance_box.clear()
    store.imbalance_ln.clear()

method clean_ob(UDT_Store store) =>
    for obj in store.ob_box
        obj.delete()
    for obj in store.ob_ln
        obj.delete()
        
    store.ob_box.clear()
    store.ob_ln.clear()

method clean_ms(UDT_Store store) =>
    for obj in store.ms_lbl
        obj.delete()
    for obj in store.ms_ln
        obj.delete()
        
    store.ms_lbl.clear()
    store.ms_ln.clear()

method clean_hl(UDT_Store store) =>
    for obj in store.hl_ln
        obj.delete()
    for obj in store.hl_lbl
        obj.delete()

    store.hl_ln.clear()
    store.hl_lbl.clear()

method clean_phl(UDT_Store store) =>
    for obj in store.phl_box
        obj.delete()
    for obj in store.phl_ln
        obj.delete()
    for obj in store.phl_lbl
        obj.delete()

    store.phl_box.clear()
    store.phl_ln.clear()
    store.phl_lbl.clear()

//#endregion

// # ========================================================================= #
// # |   End   |
// # ========================================================================= #











// # ========================================================================= #
// # |   Alerts   |
// # ========================================================================= #

//#region

method enable_ms_alerts(UDT_Alerts alerts, bool enabled, string ms_type, bool swing) =>
    if enabled

        if swing

            switch ms_type
                "CHoCH+" => alerts.chochplusswing := true
                "CHoCH"  => alerts.chochswing := true
                "BOS"    => alerts.swingbos := true
                => na
            
        else
            
            switch ms_type
                "CHoCH+" => alerts.chochplus := true
                "CHoCH"  => alerts.choch := true
                "BOS"    => alerts.bos := true
                => na
    alerts

method enable_liquidity_ehl_alerts(UDT_Alerts alerts, UDT_EHL ehl) =>
    if not na(ehl)
        alerts.ehl := true
    alerts

method enable_ob_alerts(UDT_Alerts alerts, UDT_Block block) =>
    if not na(block)
        if not block.invalidated
            alerts.ob := true
            if block.bull ? ta.crossunder(low, block.top) : ta.crossover (high, block.bottom)
                alerts.obtouch := true
            block.alert_fired := true
    alerts

method enable_swing_ob_alerts(UDT_Alerts alerts, UDT_Block block) =>
    if not na(block)
        if not block.invalidated
            alerts.swing_ob := true
            block.alert_fired := true
    alerts

method enable_imbalance_fvg_alerts(UDT_Alerts alerts, UDT_Block block) =>
    if not na(block)
        if not block.invalidated
            alerts.fvg := true
            block.alert_fired := true
    alerts

method enable_imbalance_og_alerts(UDT_Alerts alerts, UDT_Block block) =>
    if not na(block)
        if not block.invalidated
            alerts.og := true
            block.alert_fired := true
    alerts

//#endregion

// # ========================================================================= #
// # |   End   |
// # ========================================================================= #










// # ========================================================================= #
// # |   Functions   |
// # ========================================================================= #

//#region

// # Market Structure -------------------------------------------------------- #

UDT_Bar b                   = UDT_Bar.new()

b_h = b.h
b_l = b.l
b_t = b.t
b_c = b.c
b_o = b.o
b_v = b.v
b_n = b.n

UDT_Alerts bull_alert       = UDT_Alerts.new()
UDT_Alerts bear_alert       = UDT_Alerts.new()

var int internal_ms_length = ms_internal_lookback
var int swing_ms_length = ms_swing_lookback

f_zscore(src, lookback) =>

    (src - ta.sma(src, lookback)) / ta.stdev(src, lookback)

vv = f_zscore(((close - close[internal_ms_length]) / close[internal_ms_length]) * 100,internal_ms_length)

if ms_mode == "Algorithmic"

    switch

        vv >= 1.5 or vv <= -1.5 => internal_ms_length := 10
        vv >= 1.6 or vv <= -1.6 => internal_ms_length := 9
        vv >= 1.7 or vv <= -1.7 => internal_ms_length := 8
        vv >= 1.8 or vv <= -1.8 => internal_ms_length := 7
        vv >= 1.9 or vv <= -1.9 => internal_ms_length := 6
        vv >= 2.0 or vv <= -2.0 => internal_ms_length := 5
        =>                         internal_ms_length

iH = ta.pivothigh(high, internal_ms_length, internal_ms_length)
sH = ta.pivothigh(high, swing_ms_length, swing_ms_length)
iL = ta.pivotlow (low , internal_ms_length, internal_ms_length)
sL = ta.pivotlow (low , swing_ms_length, swing_ms_length)

// # Text Size --------------------------------------------------------------- #

method text_size(string size) =>

    out = switch size

        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        "Huge"   => size.huge
        "Auto"   => size.auto
    out

// # Line Style -------------------------------------------------------------- #

method line_style(string line) =>

    out = switch line

        '⎯⎯⎯'  => line.style_solid
        '----'   => line.style_dashed
        '····'   => line.style_dotted

// # Font Style -------------------------------------------------------------- #

method font_style(string font) =>

    out = switch font

        'Default'   => font.family_default
        'Monospace' => font.family_monospace

// # Colors    -------------------------------------------------------------- #

method set_opacity(color css, int opacity) =>

    blue  = color.b(css)
    red   = color.r(css)
    green = color.g(css)

    color.rgb(red, green, blue, opacity)

method darkcss(color css, float factor, bool bull) =>

    blue  = color.b(css) * (1 - factor)
    red   = color.r(css) * (1 - factor)
    green = color.g(css) * (1 - factor)

    color.rgb(red, green, blue, 0)

// # Label Style ------------------------------------------------------------- #

method label_style(string label) =>

    out = switch label

        'None'      => label.style_none
        'Circle'    => label.style_circle
        'Square'    => label.style_square
        'Diamond'   => label.style_diamond
        'Cross'     => label.style_cross
        'xCross'    => label.style_xcross

// # Table Position ---------------------------------------------------------- #
        
method table_position(string position) =>

    out = switch position

        "Bottom Center"     => position.bottom_center
        "Bottom Left"       => position.bottom_left
        "Bottom Right"      => position.bottom_right
        "Middle Center"     => position.middle_center
        "Middle Left"       => position.middle_left
        "Middle Right"      => position.middle_right
        "Top Center"        => position.top_center
        "Top Left"          => position.top_left
        "Top Right"         => position.top_right

// # Text Align -------------------------------------------------------------- #

method text_align(string align) =>

    out = switch align

        'Center'    => text.align_center
        'Top'       => text.align_top
        'Bottom'    => text.align_bottom
        'Left'      => text.align_left
        'Right'     => text.align_right

// # Swings ----------------------------------------------------------------- #

swings(len)=>    

    upper = ta.highest(len)
    lower = ta.lowest(len)

    var float out = 0
    out := b_h[len] > upper ? 0 : b_l[len] < lower ? 1 : out[1]

    top = out == 0 and out[1] != 0 ? b_h[len] : 0
    btm = out == 1 and out[1] != 1 ? b_l[len] : 0

    [top, btm]

// # Formatting ------------------------------------------------------------- #

calc_percentage(float value, float total_value) => 
    math.floor((value / total_value) * 100)

method format_percent_label(string label, float num) =>
    label_f = label == "" ? "" : str.format("{0} ", label)
    percent_label = num < 0.01 ? str.format("{0}( <1% )", label_f) : str.format("{0}({1,number,percent})", label_f, num)

    percent_label

// # Box -------------------------------------------------------------------- #

method add_volume_label(box _box, float value, float percentage) =>
    volume_f = str.tostring(value, format.volume)
    _box.set_text(format_percent_label(volume_f, percentage))

// # MTF Scanner ------------------------------------------------------------ #

method mtf_value(int value) => 
    bullish_value = 1
    bearish_value = -1
    is_bullish = value == 1
    is_bearish = value == -1
    value_f = is_bullish ? "BULLISH" : is_bearish ? "BEARISH" : "-"

    UDT_Scanner.new(value, value_f, bullish_value, bearish_value, is_bullish, is_bearish)

// # Mitigation -------------------------------------------------------------- #

// TODO: the mitigation method does not detect mitigation between internal market structure
method mitigated_imbalance(UDT_Block fvg, string imbalance_mitigation, float close_price, float low_price, float high_price, int cur_time) =>
    bool in_time_range = fvg.breaker ? (na(fvg.x_inv_point) ? false : cur_time > fvg.x_inv_point) : true
    bool mitigated = false
    
    // if imbalance_mitigation == "Close"
    //     // Close price should cross the bottom for bullish FVG or the top for bearish FVG
    //     mitigated := fvg.bull ? close_price < fvg.bottom : close_price > fvg.top
    if imbalance_mitigation == "Average"
        // Calculate the average price of the FVG (midpoint between top and bottom)
        float avg_price = fvg.mid
        
        // Close price should cross the average for mitigation (above average for bearish, below for bullish)
        mitigated := (fvg.bull ? close_price < avg_price : close_price > avg_price) and in_time_range
    else if imbalance_mitigation == "Wick"
        // For Wick option, check if the low (bullish) or high (bearish) price has breached the boundaries of the FVG
        // Bullish: Check if the low wick breaches the bottom of the FVG
        // Bearish: Check if the high wick breaches the top of the FVG
        mitigated := (fvg.bull ? low_price < fvg.bottom : high_price > fvg.top) and in_time_range
        
    mitigated

method mitigate_imbalances(array<UDT_Block> fvgs, string imbalance_mitigation, float close_price, float low_price, float high_price, int cur_time) =>
    for [index, fvg] in fvgs
        if fvg.mitigated_imbalance(imbalance_mitigation, close_price, low_price, high_price, cur_time)
            fvg.mitigated := true
    fvgs

// # Time --------------------------------------------------------------------- #
     
method get_prev_day(int current_time) =>
    // Calculate the beginning of the current day
    start_of_current_day = timestamp(year(current_time, syminfo.timezone), month(current_time, syminfo.timezone), dayofmonth(current_time, syminfo.timezone))

    // Define the offset for previous days
    offset = 1
    prev_dayofweek = dayofweek(start_of_current_day - offset * 86400000, syminfo.timezone)
    if syminfo.type == "futures" or syminfo.type == "stock"
        while not (prev_dayofweek >= dayofweek.monday and prev_dayofweek <= dayofweek.friday) // Skip weekends
            offset := offset + 1
            prev_dayofweek := dayofweek(start_of_current_day - offset * 86400000, syminfo.timezone)

    // Calculate the beginning of the previous market-opened day
    start_of_previous_market_day = start_of_current_day - offset * 86400000

    start_of_previous_market_day

method is_same_day(int prev, int cur) =>
    shift = (syminfo.type == "futures" or syminfo.type == "stock") ? 1 : 0
    dayofmonth(prev, syminfo.timezone) - shift == dayofmonth(cur, syminfo.timezone) and month(prev, syminfo.timezone) == month(cur, syminfo.timezone) and year(prev, syminfo.timezone) == year(cur, syminfo.timezone)

method get_prev_week(int current_time) =>
    // Calculate the day of the week for the current time (0 = Sunday, 1 = Monday, ..., 6 = Saturday)
    current_day_of_week = dayofweek(current_time, syminfo.timezone)

    // Find the start of the current week (Monday, or Sunday depending on your locale)
    start_of_current_week = (syminfo.type == "futures" or syminfo.type == "stock") ? timestamp(syminfo.timezone, year(current_time, syminfo.timezone), month(current_time, syminfo.timezone), dayofmonth(current_time, syminfo.timezone)) - (current_day_of_week - 1) * 86400000 : timestamp(syminfo.timezone, year(current_time, syminfo.timezone), month(current_time, syminfo.timezone), dayofmonth(current_time, syminfo.timezone))
    
    // Calculate the start of the previous week by subtracting 7 days (in milliseconds)
    start_of_previous_week = start_of_current_week - 7 * 86400000

    start_of_previous_week

method is_same_week(int prev, int cur) =>
    weekofyear(prev, syminfo.timezone) == weekofyear(cur, syminfo.timezone) and year(prev, syminfo.timezone) == year(cur, syminfo.timezone)

method get_prev_month(int cur) =>
    prev_month = month(cur, syminfo.timezone) - 1
    prev_year = year(cur, syminfo.timezone)
    if prev_month < 1
        prev_year := prev_year - 1
        prev_month := 12
    timestamp(syminfo.timezone, prev_year, prev_month, 1)

method is_same_month(int prev, int cur) =>
    shift = (syminfo.type == "futures" or syminfo.type == "stock") ? 1 : 0
    month(prev, syminfo.timezone) - shift == month(cur, syminfo.timezone) and year(prev, syminfo.timezone) == year(cur, syminfo.timezone)

method get_prev_quarter(int cur) =>
    prev_q = math.floor((month(cur, syminfo.timezone)) / 3) - 1
    prev_year = year(cur, syminfo.timezone)
    if prev_q < 1
        prev_year := prev_year - 1
        prev_q := 4
    timestamp(syminfo.timezone, prev_year, prev_q*3, 1)
    
method is_same_quarter(int prev, int cur) =>
    shift = (syminfo.type == "futures" or syminfo.type == "stock") ? 1 : 0
    math.floor(month(prev, syminfo.timezone) / 3) - shift == math.floor(month(cur, syminfo.timezone) / 3) and year(prev, syminfo.timezone) == year(cur, syminfo.timezone)

method get_prev_year(int cur) =>
    year(cur, syminfo.timezone) - 1

