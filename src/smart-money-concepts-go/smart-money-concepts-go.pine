//#region ms

// # BOS & CHoCH ------------------------------------------------------------- #

method draw_ms(UDT_MS ms) =>
    if not na(ms)
        if not na(ms.x1) and not na(ms.p)
            // if bin.ms_ln.size() >= 50
            //     del_ln = bin.ms_ln.shift()
            //     line.delete(del_ln)

            // if bin.ms_lbl.size() >= 50
            //     del_lbl = bin.ms_lbl.shift()
            //     label.delete(del_lbl)

            ln_style = ms.sweep ? line.style_dotted :
                 ms.swing ? line.style_solid : line.style_dashed
            ln = line.new(
                 x1      = ms.x1
                 , y1    = ms.p
                 , x2    = ms.x2
                 , y2    = ms.p
                 , color = ms.css
                 , width = 1
                 , style = ln_style
                 )

            bin.ms_ln.push(ln)

            label_text = ms.sweep ? "x" : ms.ms_type
            label_style = ms.bull ? label.style_label_down : label.style_label_up
            lbl = label.new(
                 x                  = int(math.avg(ms.x1, ms.x2))
                 , y                = ms.p
                 , text             = label_text
                 , color            = colors_transparent
                 , textcolor        = ms.css
                 , style            = label_style
                 , size             = text_size(general_text)
                 , text_font_family = font_style(general_font)
                 )

            bin.ms_lbl.push(lbl)

    ms

method detect_ms_structure(UDT_MS drw, bool bull, UDT_MS_PNL top, UDT_MS_PNL btm, map<string, bool > ms_types, UDT_Alerts alerts) => 
	swing = drw.swing

    if top.p.size() > 0 and btm.l.size() > 1

		if bull ? ta.crossover(b.c, top.p.first()) : ta.crossunder(b.c, top.p.first())

            color clr = bull ? (swing ? ms_swing_up_bos : ms_internal_up_bos) :  (swing ? ms_swing_down_bos : ms_internal_down_bos)

			if bull ? drw.trend < 0 : drw.trend > 0
                // CHoCH/CHoCH+ detected
				is_CHoCH_plus = bull ? btm.l.first() > btm.l.get(1) : btm.l.first() < btm.l.get(1)
                ms_type = is_CHoCH_plus ? "CHoCH+" : "CHoCH"
                drw.css := clr.darkcss(0.25, true)
                
                alerts.enable_ms_alerts(true, ms_type, swing)

                if ms_types.get(ms_type) and na(drw.x1)
                    drw.bull    := bull
                    drw.ms_type := ms_type
                    drw.x1      := top.n.first()
                    drw.x2      := b.n
                    drw.p       := top.p.first()
                    drw.xloc    := bar_index

            else
                // BOS detected
                ms_type = "BOS"
                drw.css := clr
    
                alerts.enable_ms_alerts(true, ms_type, swing)

                if ms_types.get(ms_type) and na(drw.x1)
                    drw.bull    := bull
                    drw.ms_type := ms_type
                    drw.x1      := top.n.first()
                    drw.x2      := b.n
                    drw.p       := top.p.first()
                    drw.xloc    := b.n

            is_ob = blocks_filter == "None" ? true : blocks_filter == drw.ms_type
            if bull
                drw.is_bull_ob := is_ob
            else
                drw.is_bear_ob := is_ob

			drw.trend := bull ? 1 : -1
            top.n.clear()
            top.p.clear()

    drw

map_ms_structure(string filter_type) =>
    ms_types = map.new<string, bool >()
    switch filter_type

        "All"      =>  ms_types.put("BOS" , true ),  ms_types.put("CHoCH", true ) , ms_types.put("CHoCH+", true  )
        "CHoCH"    =>  ms_types.put("BOS" , false),  ms_types.put("CHoCH", true ) , ms_types.put("CHoCH+", false )
        "CHoCH+"   =>  ms_types.put("BOS" , false),  ms_types.put("CHoCH", false) , ms_types.put("CHoCH+", true  )
        "BOS"      =>  ms_types.put("BOS" , true ),  ms_types.put("CHoCH", false) , ms_types.put("CHoCH+", false )
        "None"     =>  ms_types.put("BOS" , false),  ms_types.put("CHoCH", false) , ms_types.put("CHoCH+", false )  
        => na

    ms_types

var swing_ms_types    = map_ms_structure(ms_show_swing)
var internal_ms_types = map_ms_structure(ms_show_internal)
        
internal_structure() =>

    var UDT_MS ms     = UDT_MS.new(trend = 0, x1 = na, x2 = na, p = na, swing = false)
	var UDT_MS_PNL up = UDT_MS_PNL.new(array.new<float>(), array.new< int >(), array.new<float>())
	var UDT_MS_PNL dn = UDT_MS_PNL.new(array.new<float>(), array.new< int >(), array.new<float>())

    switch
        not na(iH) =>

            up.p.unshift(b_h      [internal_ms_length])
            up.l.unshift(b_h      [internal_ms_length])
            up.n.unshift(bar_index[internal_ms_length])

        not na(iL) =>

            dn.p.unshift(b_l      [internal_ms_length])
            dn.l.unshift(b_l      [internal_ms_length])
            dn.n.unshift(bar_index[internal_ms_length])

    ms.x1         := na
    ms.x2         := na
    ms.xloc       := na
    ms.p          := na
    ms.ms_type    := na
    ms.is_bear_ob := false
    ms.is_bull_ob := false
    ms.sweep      := false

	// Internal Bullish Strucure
    ms.detect_ms_structure(true , up, dn, internal_ms_types, bull_alert)

	// Internal Bearish Strucure
    ms.detect_ms_structure(false, dn, up, internal_ms_types, bear_alert)

    [ms.trend, ms]

swing_structure() =>

    var UDT_MS ms     = UDT_MS.new(trend = 0, x1 = na, x2 = na, p = na, swing = true)
	var UDT_MS_PNL up = UDT_MS_PNL.new(array.new<float>(), array.new< int >(), array.new<float>())
	var UDT_MS_PNL dn = UDT_MS_PNL.new(array.new<float>(), array.new< int >(), array.new<float>())

    switch

        not na(sL) =>

            dn.p.unshift(b_l      [swing_ms_length])
            dn.l.unshift(b_l      [swing_ms_length])
            dn.n.unshift(bar_index[swing_ms_length])

        not na(sH) =>

            up.p.unshift(b_h      [swing_ms_length])
            up.l.unshift(b_h      [swing_ms_length])
            up.n.unshift(bar_index[swing_ms_length])

    ms.x1         := na
    ms.x2         := na
    ms.xloc       := na
    ms.p          := na
    ms.ms_type    := na
    ms.is_bear_ob := false
    ms.is_bull_ob := false
    ms.sweep      := false

	// Swing Bullish Structure
    ms.detect_ms_structure(true , up, dn, swing_ms_types, bull_alert)

	// Swing Bearish Structure
    ms.detect_ms_structure(false, dn, up, swing_ms_types, bear_alert)

    [ms.trend, ms]

[internal_trend, internal_ms] = internal_structure()
[swing_trend   , swing_ms   ] = swing_structure()
    
//#endregion

//#region swings

// # Swings ------------------------------------------------------------------ #

var swing_high = UDT_Zphl.new(scross = true, icross = true, txt = "", x= 0, y = 0, t = high, tx = 0, ix = 0, iy = 0, vol = na)

var swing_low  = UDT_Zphl.new(scross = true, icross = true, txt = "", x= 0, y = 0, t = low , tx = 0, ix = 0, iy = 0, vol = na)

[s_ms_top, s_ms_btm] = swings(swing_ms_length)
[i_ms_top, i_ms_btm] = swings(internal_ms_length)

ms_swings(UDT_Zphl swing_hl, bool bull) =>
    swing_hl.scross := true
    swing_hl.txt    := bull ? s_ms_top > swing_hl.y ? "HH" : "HL" : s_ms_btm > swing_hl.y ? "LH" : "LL"

    topl = label.new(
               x = b.n - ms_swing_lookback
             , y = bull ? s_ms_top : s_ms_btm
             , text = swing_hl.txt
             , color     = colors_transparent
             , textcolor = bull ? pd_premium_css : pd_discount_css
             , style     = bull ? label.style_label_down : label.style_label_up
             , size      = text_size(ms_swing_point_label_size)
             , text_font_family = font_style(general_font)
             )

    swing_hl

if ms_swing_point_show
    if s_ms_top > 0
        ms_swings(swing_high, true)
        
    if s_ms_btm > 0
        ms_swings(swing_low, false)

//#endregion

// # ========================================================================= #
// # |   End   |
