alertcondition(bear_alert.chochswing       , "Bearish Swing CHOCH", "Bearish CHOCH")
alertcondition(bear_alert.swingbos         , "Bearish Swing BOS", "Bearish Swing BOS")
alertcondition(bear_alert.ehl              , "EQH", "EQH")
alertcondition(bear_alert.fvg              , "Bearish FVG", "Bearish FVG")
alertcondition(bear_alert.og               , "Bearish OG", "Bearish OG")
alertcondition(bear_alert.ob               , "Bearish Order Block", "Bearish Order Block")
