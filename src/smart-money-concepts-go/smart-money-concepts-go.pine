p_css = internal_ms.css
b_css = internal_ms.css
w_css = internal_ms.css

p_css := ms_plotcandle ? (internal_ms.css) : na
b_css := ms_barcolor   ? (internal_ms.css) : na
w_css := ms_plotcandle ? color.rgb(120, 123, 134, 50)           : na

plotcandle(open,high,low,close , color = p_css , wickcolor = w_css , bordercolor = p_css , editable = false)
barcolor(b_css, editable = false)

