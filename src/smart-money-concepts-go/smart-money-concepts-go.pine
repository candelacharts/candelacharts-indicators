//#region

// # Utilities --------------------------------------------------------------- #

shift_to_right(int current, int length, string tf) =>
    current + timeframe.in_seconds(tf) * 1000 * (length + 1)

shift_to_left(int current, int prev, int length) =>
    current - (current - prev) * length + 1

shift_bars_to_right(int bars) => 
    bars + 20

method disrespected_imbalance(UDT_Block fvg, float c_top, float c_bot) =>
    bool ifvg = false

    if fvg.bull
        ifvg := c_bot < fvg.bottom
    else
        ifvg := c_top > fvg.top
    ifvg

method limit_buffer(array<UDT_Block> data, int buffer) =>
    if data.size() >= buffer
        data.shift()
    data

method filter_fvgs(array<UDT_Block> blocks, array<UDT_Block> all_blocks, int buffer, float c_top, float c_bot) => // filtering only FVG data
    all_blocks.limit_buffer(buffer)

    // Detect FVGs, remove detected imbalance from all FVGs
    if all_blocks.size() > 0
        for i = all_blocks.size()-1 to 0
            value = all_blocks.get(i)
            if not value.disrespected_imbalance(c_top = c_top, c_bot = c_bot)
                blocks.unshift(all_blocks.remove(i))

    // Filter out disrespected FVGs
    if blocks.size() > 0
        for i = blocks.size()-1 to 0
            value = blocks.get(i)
            if value.disrespected_imbalance(c_top = c_top, c_bot = c_bot)
                value.invalidated := true
                blocks.remove(i)

    // Return the filtered out array without disrespected FVGs
    blocks

method remove_overlaped(array<UDT_Block> fvgs) =>
    int size = array.size(fvgs)
    int i = 0
    while i < size
        int j = i + 1
        while j < size
            // Get the FVGs
            fvg_1 = array.get(fvgs, i)
            fvg_2 = array.get(fvgs, j)

            // Check for overlap between fvg_1 and fvg_2
            if (fvg_1.bull == fvg_2.bull) // Only compare FVGs of the same type (bull or bear)
                // Check if the FVGs overlap
                if (fvg_1.top > fvg_2.bottom and fvg_1.bottom < fvg_2.top)
                    // Remove the more recent FVG (higher index) and adjust size
                    array.remove(fvgs, j)
                    size := size - 1  // Update the size after removal
                    j := j - 1  // Adjust j since we removed an element
            j := j + 1
        i := i + 1

    // Return the updated array without overlapped FVGs
    fvgs

method style_imbalance_box(UDT_Block fvg, box figure, bool inversion) =>
    // style border
    border_width = imbalance_border ? imbalance_border_width : 0
    border_color = inversion
             ? (fvg.bull ? imbalance_border_bear_css : imbalance_border_bull_css)
             : fvg.mitigated
                 ? imbalance_mitigation_css
                 : (fvg.bull ? imbalance_border_bull_css : imbalance_border_bear_css)
    border_style = line_style(imbalance_border_type)
    figure.set_border_width(border_width)
    figure.set_border_style(border_style)
    figure.set_border_color(border_color)
     
    // style background
    bgcolor = inversion
             ? (fvg.bull ? imbalance_bear_css : imbalance_bull_css)
             : fvg.mitigated
                 ? imbalance_mitigation_css
                 : (fvg.bull ? imbalance_bull_css : imbalance_bear_css)
    figure.set_bgcolor(bgcolor)

    // style text
    text_size = text_size(general_text)
    text_font_family = font_style(general_font)
    figure.set_text_size(text_size)
    figure.set_text_font_family(text_font_family)

    if not inversion and imbalance_elongate
        figure.set_extend(extend.right)

    figure

method style_imbalance_midline(UDT_Block fvg, line figure, bool inversion) => 
    line_color = fvg.mitigated 
         ? imbalance_mitigation_css
         : inversion
             ? (fvg.bull ? imbalance_midline_bear_css : imbalance_midline_bull_css)
             : (fvg.bull ? imbalance_midline_bull_css : imbalance_midline_bear_css)
    line_width = imbalance_midline_width
    line_style = line_style(imbalance_midline_type)

    figure.set_color(line_color)
    figure.set_width(line_width)
    figure.set_style(line_style)

    if not inversion and imbalance_elongate
        figure.set_extend(extend.right)

    figure

gap_hl() => request.security(syminfo.tickerid, imbalance_timeframe, [high[2], low[2], close[1], open[1]])

tf_gap() => request.security(syminfo.tickerid, imbalance_timeframe, [open, high, low, close])

[prev_high_2, prev_low_2, prev_close, prev_open] = gap_hl()
[gap_open, gap_high, gap_low, gap_close]         = tf_gap()

bool fvg_timeframe_change = timeframe.change(imbalance_timeframe)

get_imbalance_fvg_threshold()   => ta.atr(14) * imbalance_threshold
get_imbalance_og_threshold()    => ta.atr(14) * imbalance_threshold

// # FVG --------------------------------------------------------------------- #

method detect_fvgs(array<UDT_Block> blocks, bool bull, int buffer) => 

    id        = b.n
    float imbalance_atr = get_imbalance_fvg_threshold()
    
    int position    = 1
    int left        = shift_to_left(b.t, b_t[1], position)
    int right       = imbalance_extend ? last_bar_time : shift_to_right(b.t, imbalance_length, imbalance_timeframe)

    log.info(str.tostring(b.t)+" "+str.tostring(b_t[1])+" "+str.tostring(right))

    UDT_Block fvg   = na

    switch bull
        true => 
            top     = gap_low
            bottom  = prev_high_2
            mid     = math.avg(top,bottom)
            is_fvg_detected = top > bottom and math.abs(top - bottom) > imbalance_atr

            if is_fvg_detected and fvg_timeframe_change
                fvg := UDT_Block.new(id, left, top, right, bottom, mid, bull = true, state = 0)
                blocks.unshift(fvg)

        false =>
            top     = prev_low_2
            bottom  = gap_high
            mid     = math.avg(top,bottom)
            is_fvg_detected = bottom < top and math.abs(top - bottom) > imbalance_atr

            if is_fvg_detected and fvg_timeframe_change
                fvg := UDT_Block.new(id, left, top, right, bottom, mid, bull = false, state = 0)
                blocks.unshift(fvg)

    fvg

method draw_fvgs(array<UDT_Block> blocks) => // Draws FVGs
    if blocks.size() > 0
        for [i, fvg] in blocks
            top     = fvg.top
            bottom  = fvg.bottom
            left    = fvg.left
            right   = imbalance_extend ? last_bar_time : shift_to_right(fvg.left, imbalance_length, imbalance_timeframe) // fvg.right
            mid     = fvg.mid

            gap_box  = fvg.style_imbalance_box(box.new(left, top, right, bottom, xloc = xloc.bar_time), false)
            bin.imbalance_box.push(gap_box)

            if imbalance_midline
                midline = fvg.style_imbalance_midline(line.new(x1 = left, y1 = mid, x2 = right, y2 = mid, xloc = xloc.bar_time), false)
                bin.imbalance_ln.push(midline)
    blocks

fvg_indicator(buffer) =>
    var all_blocks       = array.new<UDT_Block>(na) // all
    var detected_blocks  = array.new<UDT_Block>(na) // detected

    bull_block = all_blocks.detect_fvgs(true , buffer) // detect bullish, limit to buffer
    bear_block = all_blocks.detect_fvgs(false, buffer) // detect bearish, limit to buffer

    detected_blocks
         .filter_fvgs(all_blocks, buffer, gap_close, gap_close)
         .mitigate_imbalances(imbalance_mitigation, gap_close, gap_low, gap_high, b.t)

    if barstate.islast
        // Remove overlaped if imbalance_overlap enabled
        if imbalance_overlap
            detected_blocks.remove_overlaped()

        bull_detected_blocks = detected_blocks.limit_filter_bull_or_bear(true , imbalance_num) // filter out bullish
        bear_detected_blocks = detected_blocks.limit_filter_bull_or_bear(false, imbalance_num) // filter out bearish

        // Add drawings
        draw_fvgs(bull_detected_blocks)
        draw_fvgs(bear_detected_blocks)

    // alerts
    bull_alert.enable_imbalance_fvg_alerts(bull_block)
    bear_alert.enable_imbalance_fvg_alerts(bear_block)

// # OG ---------------------------------------------------------------------- #

method detect_og(array<UDT_Block> blocks, bool bull, int buffer) => 
    id        = b.n
    float imbalance_atr = get_imbalance_og_threshold()
    int position        = 1
    int left            = shift_to_left(b.t, b_t[1], position)
    int right           = imbalance_extend ? last_bar_time : shift_to_right(b.t, imbalance_length, imbalance_timeframe)

    UDT_Block fvg   = na

    switch bull
        true => 
            top     = gap_low
            bottom  = gap_high[1]
            mid     = math.avg(top,bottom)
            is_fvg_detected = gap_low > gap_high[1]

            if is_fvg_detected and fvg_timeframe_change
                fvg := UDT_Block.new(id, left, top, right, bottom, mid, bull = true, state = 0)
                blocks.unshift(fvg)

        false =>
            top     = gap_low[1]
            bottom  = gap_high
            mid     = math.avg(top,bottom)
            is_fvg_detected = gap_high < gap_low[1]

            if is_fvg_detected and fvg_timeframe_change
                fvg := UDT_Block.new(id, left, top, right, bottom, mid, bull = false, state = 0)
                blocks.unshift(fvg)

    fvg

method draw_og(array<UDT_Block> blocks) => // Draws OG
    if blocks.size() > 0
        for [i, og] in blocks
            top     = og.top
            bottom  = og.bottom
            left    = og.left
            right   = imbalance_extend ? last_bar_time : shift_to_right(og.left, imbalance_length, imbalance_timeframe) // og.right
            mid     = og.mid

            imbalance_box  = og.style_imbalance_box(box.new(left, top, right, bottom, xloc = xloc.bar_time), false)
            bin.imbalance_box.push(imbalance_box)

            if imbalance_midline
                midline = og.style_imbalance_midline(line.new(x1 = left, y1 = mid, x2 = right, y2 = mid, xloc = xloc.bar_time), false)
                bin.imbalance_ln.push(midline)
    blocks

og_indicator(int buffer) => 
    var all_blocks       = array.new<UDT_Block>(na) // all
    var detected_blocks  = array.new<UDT_Block>(na) // detected

    bull_block = all_blocks.detect_og(true , buffer) // detect bullish, limit to buffer
    bear_block = all_blocks.detect_og(false, buffer) // detect bearish, limit to buffer

    detected_blocks
         .filter_fvgs(all_blocks, buffer, gap_close, gap_close)
         .mitigate_imbalances(imbalance_mitigation, gap_close, gap_low, gap_high, b.t)

    if barstate.islast
        // Remove overlaped if imbalance_overlap enabled
        if imbalance_overlap
            detected_blocks.remove_overlaped()
            
        bull_detected_blocks = detected_blocks.limit_filter_bull_or_bear(true , imbalance_num) // filter out bullish
        bear_detected_blocks = detected_blocks.limit_filter_bull_or_bear(false, imbalance_num) // filter out bearish

        // Add drawings
        draw_og(bull_detected_blocks)
        draw_og(bear_detected_blocks)

    // alerts
    bull_alert.enable_imbalance_og_alerts(bull_block)
    bear_alert.enable_imbalance_og_alerts(bear_block)

buffer  = 50 // How many max FVGs to keep in memory

// Delete drawings
bin.clean_imbalance()

if (imbalance_enable)
    switch imbalance_type

        "FVG" => 
            fvg_indicator(buffer)

        "OG" =>
            og_indicator(buffer)

//#endregion

// # ========================================================================= #
// # |   End   |
// # ========================================================================= #












// # ========================================================================= #
// # |   Premium/Equilibrium/Discount & Strong/Weak High/Low   |
// # ========================================================================= #

//#region Premium / Equilibrium / Discount

// # Premium / Equilibrium / Discount ---------------------------------------- #

method detect_bull_phl(UDT_Zphl swing_hl, int trend) =>

    swing_hl_t = swing_hl.t

    if s_ms_top > 0

        swing_hl.y      := s_ms_top
        swing_hl.x      := b.n - swing_ms_length
        swing_hl.t      := s_ms_top
        swing_hl.tx     := b.n - swing_ms_length

    if i_ms_top > 0

        swing_hl.icross := true
        swing_hl.iy     := i_ms_top
        swing_hl.ix     := b.n - internal_ms_length

    swing_hl.t          := math.max(b.h, swing_hl.t)
    swing_hl.tx         := swing_hl.t == b.h ? b.n : swing_hl.tx
    swing_hl.vol        := swing_hl.t != swing_hl_t[1] ? b.v : swing_hl.vol

    swing_hl

method draw_bull_phl(UDT_Zphl swing_hl) =>
    var l = line.new(x1 = swing_hl.tx, y1 = swing_hl.t, x2 = shift_bars_to_right(b.n), y2 = swing_hl.t, width = 1, color = pd_premium_css)
    bin.phl_ln.push(l)

    swing_hl

method detect_bear_phl(UDT_Zphl swing_hl, int trend) =>

    swing_hl_t = swing_hl.t

    if s_ms_btm > 0
         
        swing_hl.y      := s_ms_btm
        swing_hl.x      := b.n - swing_ms_length
        swing_hl.t      := s_ms_btm
        swing_hl.tx     := b.n - swing_ms_length

    if i_ms_btm > 0

        swing_hl.icross := true
        swing_hl.iy     := i_ms_btm
        swing_hl.ix     := b.n - internal_ms_length

    swing_hl.t          := math.min(b.l, swing_hl.t)
    swing_hl.tx         := swing_hl.t == b.l ? b.n : swing_hl.tx
    swing_hl.vol        := swing_hl.t != swing_hl_t[1] ? b.v : swing_hl.vol

    swing_hl

method draw_bear_phl(UDT_Zphl swing_hl) =>
    var l = line.new(x1 = swing_hl.tx, y1 = swing_hl.t, x2 = shift_bars_to_right(b.n), y2 = swing_hl.t, width = 1, color = pd_discount_css)
    bin.phl_ln.push(l)

    swing_hl

draw_mid_phl(UDT_Zphl swing_high, UDT_Zphl swing_low) =>
    right = shift_bars_to_right(b.n)
    avg   = math.avg(swing_low.t, swing_high.t)
    more  = (swing_low.tx + right) > (swing_high.tx + right) ? swing_high.tx : swing_low.tx
    dist  = math.abs((avg - b.c) / b.c)
    var l = line.new(x1 = more, y1 = avg, x2 = right, y2 = avg, color = pd_equilibrum_css, width = 1, style = line.style_solid)
    bin.phl_ln.push(l)

    var lbl = label.new(x = right, y = avg, text = pd_strong_weak_high_low ? format_percent_label("Equilibrium ", dist) : "Equilibrium", style = label.style_label_left, color = colors_transparent, textcolor = pd_equilibrum_css, size = text_size(general_text), text_font_family = font_style(general_font))
    bin.phl_lbl.push(lbl)

draw_pd_zone(UDT_Zphl swing_high, UDT_Zphl swing_low) =>
    extend_x = shift_bars_to_right(b.n)
        
    var pbx =  box.new(left = int(math.max(swing_high.x, swing_low.x)), top = swing_high.t, right = extend_x, bottom = 0.95  * swing_high.t + 0.05 * swing_low.t, bgcolor = set_opacity(pd_premium_css, 70), border_color = na)
    var ebx = pd_equilibrium_show ? box.new(left = int(math.max(swing_high.x, swing_low.x)), top = 0.525 * swing_high.t + 0.475 * swing_low.t, right = extend_x, bottom = 0.525 * swing_low.t + 0.475 * swing_high.t, bgcolor = set_opacity(pd_equilibrum_css, 70), border_color = na) : na
    var lbx = box.new(left = int(math.max(swing_high.x, swing_low.x)), top =  0.95 * swing_low.t + 0.05 * swing_high.t, right = extend_x, bottom = swing_low.t, bgcolor = set_opacity(pd_discount_css, 70), border_color = na)
    bin.phl_box.push(pbx)
    bin.phl_box.push(ebx)
    bin.phl_box.push(lbx)

// # Strong High / Weak Low ------------------------------------------------ #

draw_strong_weak_hl(UDT_Zphl swing_high, UDT_Zphl swing_low) =>
    extend_x = shift_bars_to_right(b.n)

    // Strong High

    dist_top = math.abs(swing_high.vol / (swing_high.vol + swing_low.vol))
    top_label_text = swing_trend < 0
         ? str.format("{0} | {1}", "Strong High", format_percent_label(str.tostring(swing_low.vol, format.volume), dist_top))
         : str.format("{0} | {1}", "Weak High",   format_percent_label(str.tostring(swing_high.vol, format.volume), dist_top))

    var label_top = label.new(x = extend_x, y = swing_high.t, color = colors_transparent, text  = top_label_text, textcolor = pd_premium_css, style = label.style_label_down, size = text_size(ms_swing_point_label_size), text_font_family = font_style(general_font))
    bin.phl_lbl.push(label_top)

    // Weak Low

    dist_low = 1 - dist_top//math.abs(swing_low.vol / (swing_low.vol + swing_low.vol))
    low_label_text = swing_trend > 0 
             ? str.format("{0} | {1}", "Strong Low", format_percent_label(str.tostring(swing_low.vol, format.volume), dist_low))
             : str.format("{0} | {1}", "Weak Low",   format_percent_label(str.tostring(swing_high.vol, format.volume), dist_low))
            
    var label_down = label.new(x = extend_x, y = swing_low.t, color = colors_transparent, text = low_label_text, textcolor = pd_discount_css, style = label.style_label_up, size = text_size(ms_swing_point_label_size), text_font_family = font_style(general_font))
    bin.phl_lbl.push(label_down) 

bin.clean_phl()

if pd_premium_discount_show or pd_strong_weak_high_low
    swing_high.detect_bull_phl(swing_trend)
    swing_low .detect_bear_phl(swing_trend)

    if barstate.islast
        swing_high.draw_bull_phl()
        swing_low .draw_bear_phl()

if pd_strong_weak_high_low  and barstate.islast
    draw_strong_weak_hl(swing_high, swing_low)

if pd_premium_discount_show and barstate.islast
    draw_pd_zone(swing_high, swing_low)

    if pd_equilibrium_show
        draw_mid_phl(swing_high, swing_low)

//#endregion

// # ========================================================================= #
// # |   End   |
// # ========================================================================= #










// # ========================================================================= #
// # |   Highs & Lows MTF   |
// # ========================================================================= #

//#region EQH/EQL

// # EQH/EQL ----------------------------------------------------------------- #

get_ehl_threshhold() =>
    int   position   = 2
    float threshhold = 0.1
    float atr = ta.atr(200)
    
    switch ms_eqh_eql_mode
        "Short Term"            => position := 2,  threshhold := 0.1
        "Intermediate Term"     => position := 6,  threshhold := 0.25
        "Long Term"             => position := 10, threshhold := 0.5
        
    [position, atr * threshhold]

method draw_ehl(array<UDT_EHL> ehls) => 
    if ehls.size() > 0
        len = math.min(10, ehls.size() - 1)
        for i = 0 to len
            ehl = ehls.get(i)
            text_color  = ehl.bull ? ms_eqh_eql_bull_css : ms_eqh_eql_bear_css
            label_style = ehl.bull ? label.style_label_down : label.style_label_up
            label_text  = ehl.bull ? "EQH" : "EQL"
            label_x     = int(math.avg(ehl.x2, ehl.x1))

            bin.ehl_ln.unshift(line.new(x1 = ehl.x1, y1 = ehl.y1, x2 = ehl.x2, y2 = ehl.y2, color = text_color, style = line.style_dotted, xloc = xloc.bar_time))
            bin.ehl_lbl.unshift(label.new(x = label_x, y = ehl.y2, color = colors_transparent, style = label_style, textcolor = text_color, text = label_text, size = text_size(general_text), text_font_family = font_style(general_font), xloc = xloc.bar_time))
    ehls

method detect_eh(array<UDT_EHL> ehs) =>
    [position, threshhold] = get_ehl_threshhold()

    var float high_price = 0
    var int   ehl_t  = 0

    float pivot_high = ta.pivothigh(high, position, position)

    UDT_EHL ehl = na

    if not na(pivot_high)
        mx = math.max(pivot_high, high_price)
        mn = math.min(pivot_high, high_price)
        if mx < mn + threshhold
            ehl := UDT_EHL.new(x1 = ehl_t, y1 = high_price, x2 = b_t[position], y2 = pivot_high, bull = true)
            ehs.unshift(ehl)
        high_price := pivot_high
        ehl_t      := b_t[position]
    ehl

method detect_el(array<UDT_EHL> els) =>
    [position, threshhold] = get_ehl_threshhold()

    var float low_price = 0
    var int   ehl_b  = 0

    float ehl_pivot_low = ta.pivotlow(low, position, position)

    UDT_EHL ehl = na

    if not na(ehl_pivot_low)
        mx = math.max(ehl_pivot_low, low_price)
        mn = math.min(ehl_pivot_low, low_price)
        if mn > mx - threshhold
            ehl := UDT_EHL.new(x1 = ehl_b, y1 = low_price, x2 = b_t[position], y2 = ehl_pivot_low, bull = false)
            els.unshift(ehl)
        low_price := ehl_pivot_low
        ehl_b     := b_t[position]
    ehl

bin.clean_ehl()

if ms_eqh_eql_show
    
    var UDT_EHL[] bullish_equal_hl = array.new<UDT_EHL>()
    var UDT_EHL[] bearish_equal_hl = array.new<UDT_EHL>()

    eh = bullish_equal_hl.detect_eh()
    el = bearish_equal_hl.detect_el()

    if barstate.islast
        
        bullish_equal_hl.draw_ehl()
        bearish_equal_hl.draw_ehl()

    // alerts
    bull_alert.enable_liquidity_ehl_alerts(eh)
    bear_alert.enable_liquidity_ehl_alerts(el)

//#endregion

// # ========================================================================= #
// # |   End   |
// # ========================================================================= #










// # ========================================================================= #
// # |   Highs & Lows MTF   |
// # ========================================================================= #

//#region Highs & Lows MTF

hl() => [open, high, low, time]

[pdo, pdh, pdl, pdt] = request.security(syminfo.tickerid , 'D'  , [open, high, low, time] , lookahead = barmerge.lookahead_on, gaps = barmerge.gaps_off)
[pwo, pwh, pwl, pwt] = request.security(syminfo.tickerid , 'W'  , [open, high, low, time] , lookahead = barmerge.lookahead_on, gaps = barmerge.gaps_off)
[pmo, pmh, pml, pmt] = request.security(syminfo.tickerid , 'M'  , [open, high, low, time] , lookahead = barmerge.lookahead_on, gaps = barmerge.gaps_off)
[pqo, pqh, pql, pqt] = request.security(syminfo.tickerid , '3M' , [open, high, low, time] , lookahead = barmerge.lookahead_on, gaps = barmerge.gaps_off)
[pyo, pyh, pyl, pyt] = request.security(syminfo.tickerid , '12M', [open, high, low, time] , lookahead = barmerge.lookahead_on, gaps = barmerge.gaps_off)

method draw_pivots_hl_line(UDT_MTF mtf, color css, string pdhl_style, int line_width) =>
    hl = line.new(
       x1        = mtf.x1
     , y1        = mtf.y1
     , x2        = mtf.x2
     , y2        = mtf.y2
     , xloc      = xloc.bar_time
     , color     = css
     , style     = line_style(pdhl_style)
     , width     = line_width
     )
    bin.hl_ln.push(hl)
    mtf

method draw_pivots_ll_line(UDT_MTF mtf,  color css, string pdhl_style, int line_width) =>
    ll = line.new(
       x1        = mtf.x1
     , y1        = mtf.y1
     , x2        = mtf.x2
     , y2        = mtf.y2
     , xloc      = xloc.bar_time
     , color     = css
     , style     = line_style(pdhl_style)
     , width     = line_width
     )
    bin.hl_ln.push(ll)
    mtf

method draw_pivots_label(UDT_MTF mtf, string fmt, string tf, color css) =>
    lbl = label.new(
       x         = mtf.x2
     , y         = mtf.y2
     , xloc      = xloc.bar_time
     , text      = str.format(fmt, tf)
     , color     = colors_transparent
     , textcolor = css
     , size      = text_size(general_text)
     , style     = label.style_label_left
     , text_font_family = font_style(general_font)
     )
    bin.hl_lbl.push(lbl)
    mtf

method detect_mtf_hl(UDT_MTF mtf, float prev_price, float cur_price, tf, bool inrange) =>
    if (tf == timeframe.period or timeframe.in_seconds() / 60 < timeframe.in_seconds(tf) / 60) and inrange
        if cur_price == prev_price
            mtf.x1 := time
        mtf.y1 := prev_price
        mtf.y2 := prev_price
    mtf

method detect_mtf_oc(UDT_MTF mtf, float prev_price, float cur_price, tf, bool inrange) =>
    if (tf == timeframe.period or timeframe.in_seconds() / 60 < timeframe.in_seconds(tf) / 60) and inrange
        if na(mtf.x1)
            mtf.x1 := time
        mtf.y1 := prev_price
        mtf.y2 := prev_price
    mtf

mtf_pivots(h, l, o, t, tf, css, pdhl_style, line_width, inrange) =>

    var h_mtf = UDT_MTF.new()
    var l_mtf = UDT_MTF.new()
    var o_mtf = UDT_MTF.new()
    var m_mtf = UDT_MTF.new()

    h_mtf.detect_mtf_hl(h, high, tf, inrange)
    l_mtf.detect_mtf_hl(l, low , tf, inrange)
    o_mtf.detect_mtf_oc(o, open, tf, inrange)

    if barstate.islast

        // validate high/low detections, if no candle is detected on the levels, set x1 to open 
        if na(h_mtf.x1)
            h_mtf.x1 := o_mtf.x1
        if na(l_mtf.x1)
            l_mtf.x1 := o_mtf.x1
        
        // position
        extension = shift_to_right(time, 10, timeframe.period)

        h_mtf.x2 := extension
        l_mtf.x2 := extension
        o_mtf.x2 := extension

        midline_y = (h_mtf.y1 + l_mtf.y1) / 2
        m_mtf.x1 := o_mtf.x1
        m_mtf.x2 := extension
        m_mtf.y1 := midline_y
        m_mtf.y2 := midline_y

        // Draw high line
        h_mtf.draw_pivots_hl_line(css, pdhl_style, line_width)
             .draw_pivots_label('P{0}H', tf, css)

        // Draw low line
        l_mtf.draw_pivots_ll_line(css, pdhl_style, line_width)
             .draw_pivots_label('P{0}L', tf, css)

                
bin.clean_hl()

if hl_daily
    inrange = last_bar_time.get_prev_day().is_same_day(pdt)
    mtf_pivots(pdh, pdl, pdo, pdt, 'D', hl_css_daily, hl_line_daily, hl_line_width_daily, inrange)

if hl_weekly
    inrange = last_bar_time.get_prev_week().is_same_week(pwt)
    mtf_pivots(pwh, pwl, pwo, pwt, 'W', hl_css_weekly, hl_line_weekly, hl_line_width_weekly, inrange)

if hl_monthly  
    inrange = last_bar_time.get_prev_month().is_same_month(pmt)
    mtf_pivots(pmh, pml, pmo, pmt, 'M', hl_css_monthly, hl_line_monthly, hl_line_width_monthly, inrange)

if hl_quartely
    inrange = last_bar_time.get_prev_quarter().is_same_quarter(pqt)
    mtf_pivots(pqh, pql, pqo, pqt, '3M', hl_css_quaterly, hl_line_quaterly, hl_line_width_quaterly, inrange)

if hl_yearly
    inrange = last_bar_time.get_prev_year() == year(pyt)
    mtf_pivots(pyh, pyl, pyo, pyt, '12M', hl_css_yearly, hl_line_yearly, hl_line_width_yearly, inrange)

//#endregion

